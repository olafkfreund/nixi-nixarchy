#!/usr/bin/env python3
# omarchy:summary=Print the local nixarchy manual excerpt that best answers a question
# omarchy:args=<question>
# omarchy:hidden=true
"""Grounding for the Nixi overlay.

The overlay's bridge runs this before each prompt and prepends what it prints,
so most questions are answered from the local nixarchy + Omarchy manual copy
without the agent spending tool calls searching for it. Prints nothing, and
exits 0, when nothing matches well enough -- a bad excerpt is worse than none.

The search is nixi-server's local_answer(), moved here unchanged: the scoring,
tokenizer and section splitting are what tools/test_nixi.py already verifies.
Stdlib only, no network.
"""
import os
import re as _re
import stat
import subprocess
import sys

DIR = os.path.expanduser(os.environ.get("NIXI_DIR", "~/.config/nixi"))
# Bundled knowledge may live inside the package (nothing placed in ~/.config);
# a real install takes precedence.
_FALLBACK = os.environ.get("NIXI_FALLBACK_DIR")
if _FALLBACK and not os.path.isfile(os.path.join(DIR, "KNOWLEDGE.md")):
    DIR = _FALLBACK
DATA = os.path.expanduser(os.environ.get("NIXI_DATA", "~/.local/share/nixi"))


def bounded_read(path, cap):
    """Bounded read of bundled or fetched content. These may legitimately be
    symlinks in dotfile-managed setups, so symlinks are followed, but the
    target must be a regular file within the size cap."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise ValueError("not a regular file")
        if st.st_size > cap:
            raise ValueError("file too large")
        buf = bytearray()
        while len(buf) <= cap:
            chunk = os.read(fd, min(65536, cap + 1 - len(buf)))
            if not chunk:
                break
            buf.extend(chunk)
        if len(buf) > cap:
            raise ValueError("file grew past cap")
        return bytes(buf)
    finally:
        os.close(fd)


_WORD = _re.compile(r"[a-zA-Z][a-zA-Z0-9+\-]{1,}")
_STOP = set("the a an and or of to in on for with how do i does what is are my "
            "you your it this that can where when omarchy use using used why "
            "work works working different way ways get set new want would "
            "should could there some more make makes".split())


def _tokens(text):
    out = []
    for w in _WORD.findall(text):
        w = w.lower()
        if w in _STOP:
            continue
        # cheap stemming so app/apps, theme/themes, keybinding/keybindings meet
        if len(w) > 3 and w.endswith("s") and not w.endswith("ss"):
            w = w[:-1]
        out.append(w)
    return out


def _sections():
    docs = []
    for base, tag in ((os.path.join(DATA, "manual"), "manual"),
                      (DIR, "notes"), (DATA, "notes")):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".md"):
                continue
            if tag == "notes" and name not in ("KNOWLEDGE.md", "LEARNED.md", "LOCAL.md"):  # noqa
                continue
            try:
                text = bounded_read(os.path.join(base, name), 524288).decode("utf-8", "replace")
            except (OSError, ValueError):
                continue
            fname_words = " ".join(name[:-3].split("-"))
            for part in _re.split(r"\n(?=#{1,3} )", text):
                lines = part.strip().splitlines()
                if not lines:
                    continue
                head = (lines[0].lstrip("# ").strip() or name) + " " + fname_words
                body = "\n".join(lines[1:]).strip()
                if body:
                    docs.append((f"{head}", body, tag))
    return docs


def _keybinds():
    # nixi-server ran this through its supervised run_capped(), built for
    # minute-long agent calls. This process lives for one prompt, so a plain
    # timeout is the whole of what is needed.
    try:
        return subprocess.run(["omarchy", "menu", "keybindings", "--print"],
                              capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return ""


# nixarchy ships a panel for five jobs, and KNOWLEDGE.md's "nixarchy's own
# tools" table says which. Word overlap cannot find that table -- its rows
# share few words with the questions, so a dual-boot page won "install btop"
# (#31). These words route a question to its row instead. They are ranking
# tuning, so they live here; the facts stay in KNOWLEDGE.md. Never "app":
# "close an app" is not an install question.
TOOL_JOBS = (   # precedence: first match wins
    ("nixarchy.distrobox", "deb rpm aur ubuntu debian fedora arch distro distribution "
                           "box boxes distrobox appimage"),
    ("nixarchy.devenv", "environment toolchain venv virtualenv devenv python node nodejs "
                        "go rust java ruby sdk project"),
    ("nixarchy.pkg", "install uninstall remove package apt pacman yay flatpak"),
    ("nixarchy.microvm", "vm vms virtual sandbox throwaway disposable microvm"),
    ("nixarchy.podman", "container docker podman compose"),
)
_TOOL_TRIGGERS = [(tool, set(_tokens(words))) for tool, words in TOOL_JOBS]
TOOLS_LIMIT = 900     # the matched rows plus rules 1 and 2, whole
TOOLS_THRESHOLD = 5.5   # a manual excerpt must be strong to ride along


def _tool_ids(q):
    words = set()
    for w in _tokens(q):
        words.add(w)
        words.update(p for p in w.split("-") if p)
    return [tool for tool, triggers in _TOOL_TRIGGERS if words & triggers][:2]


def _tools_part(ids):
    """The table rows for ids and the first two rules, from KNOWLEDGE.md."""
    if not ids:
        return ""
    try:
        text = bounded_read(os.path.join(DIR, "KNOWLEDGE.md"), 524288).decode("utf-8", "replace")
    except (OSError, ValueError):
        return ""
    section = text.split("## nixarchy's own tools", 1)
    if len(section) < 2:
        return ""
    section = section[1].split("\n## ", 1)[0]
    rows = []
    for tool in ids:
        for line in section.splitlines():
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if len(cells) >= 6 and cells[1] == f"`{tool}`":
                rows.append(" · ".join(cells))
    if not rows:
        return ""
    rules = _re.findall(r"^\d\. .*(?:\n   .*)*", section, _re.M)[:2]
    out = ("From the notes — nixarchy's own tools (prefer these; check before recommending):\n"
           + "\n".join(rows) + "\n" + "\n".join(" ".join(r.split()) for r in rules))
    return out if len(out) <= TOOLS_LIMIT else out[:TOOLS_LIMIT].rsplit(" ", 1)[0] + " …"


def local_answer(q):
    """Best-matching manual/knowledge section for q, or None."""
    qt = _tokens(q)
    if not qt:
        return None
    qset = set(qt)
    best, score = None, 0.0
    for head, body, tag in _sections():
        ht, bt = _tokens(head), _tokens(body)
        if not bt:
            continue
        hmatch = len(qset & set(ht))
        s = 3.0 * hmatch                            # title/filename hits: undamped
        if hmatch and ht:
            s += 1.5 * hmatch / len(set(ht))        # focused titles beat long ones
        freq = sum(min(bt.count(w), 3) for w in qset)   # repeated terms matter
        s += freq / (1 + 0.02 * len(bt))
        if s > score:
            best, score = (head, body, tag), s
    # keybinding questions: grep the live bindings too
    kb_hit = ""
    if any(w in qset for w in ("key", "keys", "shortcut", "keybinding", "bind",
                               "super", "press", "hotkey")):
        kb = _keybinds()
        hits = [l for l in kb.splitlines()
                if any(w in l.lower() for w in qt)][:4]
        kb_hit = "\n".join(hits)
    tools = _tools_part(_tool_ids(q))
    if tools and score < TOOLS_THRESHOLD:
        best = None             # a weak manual match would dilute the tool row
    if not tools and score < 3.8 and not kb_hit:
        return None
    parts = [tools] if tools else []
    if best:
        body = best[1]
        body = body if len(body) <= 700 else body[:700].rsplit(" ", 1)[0] + " …"
        parts.append(f"From the {'manual' if best[2] == 'manual' else 'notes'} — {best[0]}:\n{body}")
    if kb_hit:
        parts.append("Your live keybindings say:\n" + kb_hit)
    return "\n\n".join(parts)


def main(argv):
    question = " ".join(argv).strip()
    if not question:
        print("usage: nixi-context <question>", file=sys.stderr)
        return 64
    answer = local_answer(question)
    if answer:
        print(answer)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
