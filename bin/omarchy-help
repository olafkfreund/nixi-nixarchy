#!/usr/bin/env bash
# omarchy:summary=Open the Omarchy Helper chat widget (toggle show/hide)
# omarchy:args=[--tui] [question]
# Omarchy Helper: opens the corner chat widget (grounded Claude answers).
# --tui opens the plain terminal session instead. Requires Claude Code.
set -euo pipefail
DIR="${OMARCHY_HELP_DIR:-$HOME/.config/omarchy-help}"
PORT="${OMARCHY_HELP_PORT:-8642}"
[[ -f "$DIR/CLAUDE.md" ]] || { echo "omarchy-helper not installed at $DIR (run install.sh)"; exit 1; }

DATA="${OMARCHY_HELP_DATA:-$HOME/.local/share/omarchy-help}"
tok() { cat "$DATA/.token" 2>/dev/null || true; }

ASK=""
WANT_TOUR=""
if [[ "${1:-}" == "--tour" ]]; then
  WANT_TOUR=1
  shift
fi
if [[ "${1:-}" == "--ask" ]]; then
  ASK="${2:?--ask needs a question}"
  shift 2
fi

if [[ "${1:-}" == "--tui" ]]; then
  cd "$DIR"; exec claude "${2:-Greet me in one short line as the Omarchy Helper and ask what I want to know.}"
fi

if ! curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  setsid omarchy-help-server >/dev/null 2>&1 < /dev/null &
  for _ in $(seq 1 30); do
    curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break
    sleep 0.2
  done
fi
if [[ -n "$WANT_TOUR" ]]; then
  curl -fsS -X POST -H "X-Archy-Token: $(tok)" "http://127.0.0.1:$PORT/tour/start" >/dev/null 2>&1
fi

if [[ -n "$ASK" ]]; then
  curl -fsS -X POST -H "X-Archy-Token: $(tok)" "http://127.0.0.1:$PORT/prime" -H "Content-Type: application/json" \
    -d "$(python3 -c "import json,sys; print(json.dumps({'q': sys.argv[1]}))" "$ASK")" >/dev/null 2>&1
fi

# Website-bubble toggle: the widget lives on the special:helper overlay
# (window rule). If it exists, show/hide the overlay; else open it fresh
# and reveal the overlay once the window is mapped.
toggle() { curl -fsS -X POST -H "X-Archy-Token: $(tok)" "http://127.0.0.1:$PORT/minimize" >/dev/null 2>&1; }
if curl -fsS "http://127.0.0.1:$PORT/status" 2>/dev/null | grep -q '"window": true'; then
  if [[ -n "$ASK" ]]; then
    curl -fsS -X POST -H "X-Archy-Token: $(tok)" "http://127.0.0.1:$PORT/show" >/dev/null 2>&1   # reveal, never hide, when carrying a question
  else
    toggle
  fi
  exit 0
fi
omarchy-launch-webapp "http://127.0.0.1:$PORT" >/dev/null 2>&1 || true
for _ in $(seq 1 40); do
  if curl -fsS "http://127.0.0.1:$PORT/status" 2>/dev/null | grep -q '"window": true'; then
    sleep 0.3   # let the window-rule finish placing it
    curl -fsS -X POST -H "X-Archy-Token: $(tok)" "http://127.0.0.1:$PORT/show" >/dev/null 2>&1
    exit 0
  fi
  sleep 0.25
done
echo "helper window did not appear" >&2; exit 1
