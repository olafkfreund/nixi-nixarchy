#!/usr/bin/env bash
# Omarchy Helper: opens the corner chat widget (grounded Claude answers).
# --tui opens the plain terminal session instead. Requires Claude Code.
set -euo pipefail
DIR="${OMARCHY_HELP_DIR:-$HOME/.config/omarchy-help}"
PORT="${OMARCHY_HELP_PORT:-8642}"
[[ -f "$DIR/CLAUDE.md" ]] || { echo "omarchy-helper not installed at $DIR (run install.sh)"; exit 1; }

if [[ "${1:-}" == "--tui" ]]; then
  cd "$DIR"; exec claude "${2:-Greet me in one short line as the Omarchy Helper and ask what I want to know.}"
fi

if ! curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  setsid omarchy-help-server >/dev/null 2>&1 < /dev/null &
  for _ in $(seq 1 30); do
    curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break
    sleep 0.2
  done
fi
# Toggle behavior: if the widget window already exists, show/hide its
# special workspace (website-bubble style); otherwise open it fresh.
if curl -fsS -X POST "http://127.0.0.1:$PORT/minimize" 2>/dev/null | grep -q '"ok": true'; then
  RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  SIG="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls "$RUN/hypr" 2>/dev/null | head -1)}"
  [[ -n "$SIG" ]] && printf "dispatch togglespecialworkspace helper" | python3 -c "
import socket,sys,os
s=socket.socket(socket.AF_UNIX); s.connect(os.path.join(\"$RUN\",\"hypr\",\"$SIG\",\".socket.sock\"))
s.send(sys.stdin.buffer.read()); s.recv(100)"
  exit 0
fi
exec omarchy-launch-webapp "http://127.0.0.1:$PORT"
