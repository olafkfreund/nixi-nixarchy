#!/usr/bin/env bash
# omarchy:summary=Open the Nixi card (toggle show/hide)
# omarchy:args=[--tui] [--tour]
# Nixi: your nixarchy guide, as a native Omarchy overlay.
#
# The shell owns the card, so this is a toggle over its IPC -- no browser, no
# server, no window rules. The Omarchy menu's Help row and any SUPER+H binding
# run this, so it stays the name everything else points at.
set -euo pipefail

PLUGIN="${NIXI_PLUGIN_ID:-io.github.olafkfreund.nixi}"

case "${1:-}" in
  --tui)
    # A plain terminal session with the same grounding the card uses: the agent
    # starts in nixi's config directory, so it loads nixi's CLAUDE.md.
    DIR="${NIXI_DIR:-$HOME/.config/nixi}"
    [[ -d "$DIR" ]] || DIR="$HOME"
    cd "$DIR"
    exec claude "${2:-Greet me in one short line as Nixi, the nixarchy guide, and ask what I want to know.}"
    ;;
  --tour)
    # summon, not toggle: the first-boot welcome hook must open the card, never
    # close one the user already has open.
    exec omarchy-shell shell summon "$PLUGIN" '{"action":"tour"}'
    ;;
  "")
    exec omarchy-shell shell toggle "$PLUGIN" '{}'
    ;;
  *)
    echo "usage: nixi [--tui] [--tour]" >&2
    exit 64
    ;;
esac
