#!/usr/bin/env bash
# omarchy:summary=Open the Nixi chat widget (toggle show/hide)
# omarchy:args=[--tui] [question]
# Nixi: opens the corner chat widget (grounded agent answers).
# --tui opens the plain terminal session instead. Requires Claude Code.
set -euo pipefail
DIR="${NIXI_DIR:-$HOME/.config/nixi}"
PORT="${NIXI_PORT:-8642}"
# `nix run` has no ~/.config/nixi at all, so fall back to the assets inside
# the package itself (NIXI_FALLBACK_DIR is set by the Nix wrapper). A real
# install still wins, so local overrides keep working.
if [[ ! -f "$DIR/ui.html" && -f "${NIXI_FALLBACK_DIR:-/nonexistent}/ui.html" ]]; then
  DIR="$NIXI_FALLBACK_DIR"
fi
export NIXI_DIR="$DIR"   # the server we spawn must read the same directory
[[ -f "$DIR/ui.html" ]] || {
  echo "nixi has no widget files at $DIR." >&2
  echo "  NixOS/nixarchy: enable services.nixi in your Home Manager config," >&2
  echo "                  then home-manager switch (or nixarchy apply)," >&2
  echo "                  or: omarchy plugin add https://github.com/olafkfreund/nixi-nixarchy.git --enable" >&2
  echo "  Anything else:  run ./install.sh from the checkout." >&2
  exit 1
}

DATA="${NIXI_DATA:-$HOME/.local/share/nixi}"
tok() { cat "$DATA/.token" 2>/dev/null || true; }

ASK=""
WANT_TOUR=""
if [[ "${1:-}" == "--tour" ]]; then
  WANT_TOUR=1
  shift
fi
if [[ "${1:-}" == "--ask" ]]; then
  ASK="${2:?--ask needs a question}"
  shift 2
fi

if [[ "${1:-}" == "--tui" ]]; then
  cd "$DIR"; exec claude "${2:-Greet me in one short line as Nixi, the nixarchy guide, and ask what I want to know.}"
fi

if ! curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  setsid nixi-server >/dev/null 2>&1 < /dev/null &
  for _ in $(seq 1 30); do
    curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break
    sleep 0.2
  done
fi
if [[ -n "$WANT_TOUR" ]]; then
  curl -fsS -X POST -H "X-Nixi-Token: $(tok)" "http://127.0.0.1:$PORT/tour/start" >/dev/null 2>&1
fi

if [[ -n "$ASK" ]]; then
  curl -fsS -X POST -H "X-Nixi-Token: $(tok)" "http://127.0.0.1:$PORT/prime" -H "Content-Type: application/json" \
    -d "$(python3 -c "import json,sys; print(json.dumps({'q': sys.argv[1]}))" "$ASK")" >/dev/null 2>&1
fi

# Website-bubble toggle: the widget lives on the special:helper overlay
# (window rule). If it exists, show/hide the overlay; else open it fresh
# and reveal the overlay once the window is mapped.
toggle() { curl -fsS -X POST -H "X-Nixi-Token: $(tok)" "http://127.0.0.1:$PORT/minimize" >/dev/null 2>&1; }
status() { curl -fsS -H "X-Nixi-Token: $(tok)" "http://127.0.0.1:$PORT/status" 2>/dev/null; }
if status | grep -q '"window": true'; then
  if [[ -n "$ASK" ]]; then
    curl -fsS -X POST -H "X-Nixi-Token: $(tok)" "http://127.0.0.1:$PORT/show" >/dev/null 2>&1   # reveal, never hide, when carrying a question
  else
    toggle
  fi
  exit 0
fi
# Apply the float/pin placement rule before the window exists.
curl -fsS -X POST -H "X-Nixi-Token: $(tok)" "http://127.0.0.1:$PORT/prepare" >/dev/null 2>&1 || true
omarchy-launch-webapp "http://127.0.0.1:$PORT" >/dev/null 2>&1 || true
for _ in $(seq 1 40); do
  if status | grep -q '"window": true'; then
    sleep 0.3   # let the window-rule finish placing it
    curl -fsS -X POST -H "X-Nixi-Token: $(tok)" "http://127.0.0.1:$PORT/show" >/dev/null 2>&1
    exit 0
  fi
  sleep 0.25
done
echo "helper window did not appear" >&2; exit 1
