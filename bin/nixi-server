#!/usr/bin/env python3
# omarchy:summary=Serve the Nixi chat widget (offline manual answers + agent relay)
# omarchy:hidden=true
"""Nixi micro-server: serves the chat widget UI and relays each
message to a headless Claude Code call (with read-only grounding tools).
Local only (127.0.0.1), stdlib only, no telemetry."""
import array
import http.server
import json
import math
import os
import secrets
import signal
import stat
import subprocess
import sys
import threading
import time
import wave

PORT = int(os.environ.get("NIXI_PORT", "8642"))
DIR = os.path.expanduser(os.environ.get("NIXI_DIR", "~/.config/nixi"))
# Served content may also live inside the package (a `nix run`, where nothing
# was ever placed in ~/.config). A real install takes precedence.
_FALLBACK = os.environ.get("NIXI_FALLBACK_DIR")
if _FALLBACK and not os.path.isfile(os.path.join(DIR, "ui.html")):
    DIR = _FALLBACK
# Mutable state (fetched manual, learned facts) lives OUTSIDE the config dir
# so dotfile-manager redeploys can never wipe it.
DATA = os.path.expanduser(os.environ.get("NIXI_DATA", "~/.local/share/nixi"))
UI = os.path.join(DIR, "ui.html")
ALLOWED = ",".join([
    "Read", "Grep", "Glob",
    "Bash(omarchy menu keybindings --print)",
    "Bash(hyprctl binds)", "Bash(hyprctl clients)", "Bash(hyprctl workspaces)",
    "Bash(ls /usr/share/omarchy/bin)",
])
# systemd user services start with a bare PATH; the user's agent binary
# usually lives in ~/.local/bin or a version-manager shim dir (mise, asdf).
for _d in ("~/.local/bin", "~/.local/share/mise/shims", "~/.asdf/shims"):
    _d = os.path.expanduser(_d)
    if os.path.isdir(_d) and _d not in os.environ.get("PATH", ""):
        os.environ["PATH"] = _d + os.pathsep + os.environ.get("PATH", "")

# ---- request security ------------------------------------------------------
# The server is localhost-only, but "localhost" includes every website the
# user's browser has open (CSRF/DNS-rebinding). Defenses, per the marketplace
# security review: an unguessable per-session token required on every
# state-touching request (also delivered to local CLI callers via a 0600
# file), a strict Host/Origin allowlist, JSON-only bodies with a hard size
# cap, and no CORS headers ever (so cross-origin reads stay blocked).
TOKEN = secrets.token_hex(16)
_HOSTS = {"127.0.0.1:%d" % PORT, "localhost:%d" % PORT, "127.0.0.1", "localhost"}
_ORIGINS = {"http://127.0.0.1:%d" % PORT, "http://localhost:%d" % PORT}
# GETs that are pure, token-free reads. Everything else needs the token.
_PUBLIC_GET = ("/", "/index.html", "/health")


# ---- descriptor-bound file I/O --------------------------------------------
# Private state (token, trust, learning) is only ever touched through a
# retained directory descriptor: the directory must be ours and not
# group/world-writable; files are opened relative to it with O_NOFOLLOW |
# O_NONBLOCK and validated by fstat (regular, ours, private, bounded) before
# a byte is read; writes go to an O_EXCL random 0600 temp in the same
# directory, fsync'd, renamed over a target that must not be a symlink, then
# the directory itself is fsync'd. Kept in sync with install.py.
_UID = os.getuid()
_HOME = os.path.abspath(os.path.expanduser("~"))


def _group_exclusive(gid):
    """A group-writable directory is acceptable only if the group is provably
    ours alone: our primary group, no other account has it as primary, and
    no member other than us."""
    import grp
    import pwd
    if gid != os.getgid():
        return False
    try:
        g = grp.getgrgid(gid)
        me = pwd.getpwuid(_UID).pw_name
    except KeyError:
        return False
    if any(m != me for m in g.gr_mem):
        return False
    return not any(p.pw_gid == gid and p.pw_uid != _UID for p in pwd.getpwall())


def _dir_ok(st):
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != _UID or (st.st_mode & 0o002):
        return False
    if st.st_mode & 0o020:
        return _group_exclusive(st.st_gid)
    return True


def _dirfd(path, create=False, mode=0o700):
    """Open a directory under $HOME by walking every component from the
    $HOME anchor with O_NOFOLLOW|O_DIRECTORY, validating each directory
    (ours, never world-writable, group-writable only if exclusive). A
    symlink anywhere on the path is refused. Returns the leaf descriptor;
    callers keep it for every relative operation that follows."""
    path = os.path.abspath(path)
    if path != _HOME and not path.startswith(_HOME + os.sep):
        raise PermissionError("outside $HOME: " + path)
    fd = os.open(_HOME, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        if not _dir_ok(os.fstat(fd)):
            raise PermissionError("untrusted $HOME")
        for comp in [c for c in path[len(_HOME):].split(os.sep) if c]:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            try:
                nfd = os.open(comp, flags, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(comp, mode, dir_fd=fd)
                nfd = os.open(comp, flags, dir_fd=fd)
            os.close(fd)
            fd = nfd
            if not _dir_ok(os.fstat(fd)):
                raise PermissionError("untrusted directory: " + path)
        return fd
    except BaseException:
        os.close(fd)
        raise


def _read_fd_bounded(fd, cap, private):
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        raise ValueError("not a regular file")
    if private and (st.st_uid != _UID or (st.st_mode & 0o077)):
        raise PermissionError("state file not private")
    if st.st_size > cap:
        raise ValueError("file too large")
    buf, total = bytearray(), 0
    while total <= cap:
        chunk = os.read(fd, min(65536, cap + 1 - total))
        if not chunk:
            break
        buf.extend(chunk)
        total += len(chunk)
    if total > cap:
        raise ValueError("file grew past cap")
    return bytes(buf)


def secure_read(dirpath, name, cap):
    """Bounded read of a PRIVATE state file, descriptor-relative."""
    dfd = _dirfd(dirpath)
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                     dir_fd=dfd)
    finally:
        os.close(dfd)
    try:
        return _read_fd_bounded(fd, cap, private=True)
    finally:
        os.close(fd)


def secure_write(dirpath, name, data, mode=0o600):
    """Atomic durable replace of a private state file: O_EXCL random temp in
    the same directory, fsync, rename over a non-symlink target, fsync dir."""
    if isinstance(data, str):
        data = data.encode()
    dfd = _dirfd(dirpath, create=True)
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(8))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                     mode, dir_fd=dfd)
        try:
            view = memoryview(data)
            while view:
                n = os.write(fd, view)
                view = view[n:]
            os.fsync(fd)
        finally:
            os.close(fd)
        try:
            cur = os.stat(name, dir_fd=dfd, follow_symlinks=False)
            if not stat.S_ISREG(cur.st_mode):
                raise PermissionError("refusing to replace non-regular file: " + name)
        except FileNotFoundError:
            pass
        os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
        os.fsync(dfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dfd)
        except OSError:
            pass
        raise
    finally:
        os.close(dfd)


def bounded_read(path, cap):
    """Bounded read of SERVED content (ui, vendor js, knowledge, faq). These
    may legitimately be symlinks in dotfile-managed setups, so symlinks are
    followed, but the target must be a regular file within the size cap."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        return _read_fd_bounded(fd, cap, private=False)
    finally:
        os.close(fd)


def _peer_uid(port):
    """Owner uid of the loopback TCP client on `port`, from /proc/net/tcp.
    Loopback is shared by every local user; the capability token alone
    would leak through the token-free page to another account. Fail closed."""
    want_local = "0100007F:%04X" % port
    want_rem = "0100007F:%04X" % PORT
    try:
        with open("/proc/net/tcp") as f:
            for line in f:
                parts = line.split()
                if len(parts) > 7 and parts[1] == want_local and parts[2] == want_rem:
                    return int(parts[7])
    except (OSError, ValueError):
        pass
    return None


TOKEN_FILE = ".token"


def _write_token():
    secure_write(DATA, TOKEN_FILE, TOKEN)


def _repair_private_modes():
    """State files written by older versions were 0644; the private-file
    check would reject them and silently reset progress. Tighten our own
    regular files to 0600 once (descriptor-bound, never through symlinks)."""
    try:
        dfd = _dirfd(DATA, create=True)
    except (OSError, PermissionError):
        return
    try:
        for name in ("learning.json", "tips.json", "trust", ".token", "LEARNED.md"):
            try:
                fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                             dir_fd=dfd)
            except OSError:
                continue
            try:
                st = os.fstat(fd)
                if stat.S_ISREG(st.st_mode) and st.st_uid == _UID and (st.st_mode & 0o077):
                    os.fchmod(fd, 0o600)
            finally:
                os.close(fd)
    finally:
        os.close(dfd)


# ---- supervised subprocess boundary ---------------------------------------
# Each command runs inside its own transient systemd user SCOPE (a cgroup
# with a unique, never-reused unit name). Cleanup kills the scope by NAME —
# an identity-bound handle — so no numeric PID/PGID is ever signalled after
# it could have been reused. Without systemd-run the fallback only signals
# the group while the leader is provably alive (before it is reaped).
import shutil as _shutil
MAX_OUT = 2_000_000  # bytes of agent stdout/stderr we will ever buffer
_HAVE_SCOPE = bool(_shutil.which("systemd-run")) and bool(_shutil.which("systemctl"))
_LIVE = {}            # unit name -> Popen
_LIVE_LOCK = threading.Lock()


def _scope_kill(unit):
    try:
        subprocess.run(["systemctl", "--user", "kill", "--signal=SIGKILL", unit + ".scope"],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except Exception:
        pass


def run_capped(cmd, timeout, cwd=None):
    """Run cmd under supervision. Output is capped at the producer; overflow,
    timeout, any error and server shutdown kill the whole scope (or, in the
    fallback, the live group) and reap it. Overflow is an error, never a
    silent truncation."""
    unit = "nixi-" + secrets.token_hex(6)
    full = (["systemd-run", "--user", "--scope", "--quiet", "--collect",
             "--unit=" + unit, "--"] + list(cmd)) if _HAVE_SCOPE else list(cmd)
    p = subprocess.Popen(full, cwd=cwd, stdin=subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         start_new_session=True, close_fds=True)
    with _LIVE_LOCK:
        _LIVE[unit] = p

    def kill():
        if _HAVE_SCOPE:
            _scope_kill(unit)
        elif p.poll() is None:            # leader alive => PGID identity valid
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass

    overflow = threading.Event()

    def drain(stream, sink):
        try:
            while True:
                chunk = stream.read(65536)
                if not chunk:
                    return
                if len(sink) + len(chunk) > MAX_OUT:
                    sink.extend(chunk[:MAX_OUT - len(sink)])
                    overflow.set()
                    kill()                # stop the producer NOW, not at deadline
                    return
                sink.extend(chunk)
        except (OSError, ValueError):
            pass

    out, err = bytearray(), bytearray()
    to = threading.Thread(target=drain, args=(p.stdout, out), daemon=True)
    te = threading.Thread(target=drain, args=(p.stderr, err), daemon=True)
    to.start(); te.start()
    try:
        try:
            p.wait(timeout=timeout)
        except BaseException:
            kill()                        # timeout or any other error
            p.wait()
            raise
        kill()                            # leader done: clear descendants by NAME
    finally:
        with _LIVE_LOCK:
            _LIVE.pop(unit, None)
    to.join(5); te.join(5)
    for f in (p.stdout, p.stderr):
        try:
            f.close()
        except OSError:
            pass
    if overflow.is_set():
        raise RuntimeError("output limit exceeded; the process scope was terminated")
    return p.returncode, out.decode("utf-8", "replace"), err.decode("utf-8", "replace")


def spawn_detached(cmd):
    """Fire-and-forget launch of a DESKTOP helper (editor, notification) that
    must outlive the request: own session, no pipes, no inherited fds. The
    only launches not routed through run_capped, by design."""
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)


def _shutdown(*_):
    with _LIVE_LOCK:
        live = list(_LIVE.items())
    for unit, p in live:
        if _HAVE_SCOPE:
            _scope_kill(unit)
        elif p.poll() is None:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
    # A recorder outliving the server would hold the microphone open with
    # nothing left to stop it.
    try:
        _discard()
    except Exception:
        pass
    sys.exit(0)


