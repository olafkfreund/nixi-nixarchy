# ---- the LIVE tour: Nixi instructs, the event socket confirms ----------
# Steps chosen so every action is verifiable from socket2 AND safe while the
# widget overlay is visible (no other special workspace involved).
TOUR = [
    # (instruction, kind, matcher, count). Texts are structured for the
    # widget's renderer: lead line + "- " bullets + **bold** keys.
    ("**SUPER** is the Windows key (\u229e, next to ALT \u2014 \u2318 on a Mac).\n"
     "It runs this whole OS. First: connect your AI.\n"
     "- Press **SUPER+SPACE**\n"
     "- Go to **Setup \u2192 Default agent**\n"
     "- Pick one (Claude Code, Codex\u2026)",
     "poll", lambda: bool(default_agent()), 1),
    ("Now the essentials.\n"
     "- **SUPER+RETURN** opens a terminal \u2014 try it\n"
     "Bonus: **SUPER+C / SUPER+V** copy-paste works everywhere, even in there.",
     "event", lambda ev, d: ev == "openwindow" and any("," + x + "," in "," + d.lower() + "," for x in ("foot", "alacritty", "kitty", "com.mitchellh.ghostty", "ghostty")), 1),
    ("Your browser has its own key.\n"
     "- Press **SUPER+SHIFT+RETURN**",
     "event", lambda ev, d: ev == "openwindow" and any(
         b in d.lower() for b in ("brave", "chromium", "firefox", "helium")), 1),
    ("One more terminal: **SUPER+RETURN**.\n"
     "Watch the windows share the screen evenly \u2014 no overlap, no dragging.\n"
     "That\u2019s tiling.",
     "event", lambda ev, d: ev == "openwindow" and any("," + x + "," in "," + d.lower() + "," for x in ("foot", "alacritty", "kitty", "com.mitchellh.ghostty", "ghostty")), 1),
    ("The move that kills the mouse:\n"
     "- **SUPER+arrows** jump focus between panes\n"
     "Bounce around a few times \u2014 watch the highlight travel.",
     "event", lambda ev, d: ev == "activewindow", 4),
    ("Time to tidy up:\n"
     "- Steer onto a window with **SUPER+arrows**\n"
     "- **SUPER+W** closes it \u2014 no titlebar needed\n"
     "Close TWO of them.",
     "event", lambda ev, d: ev == "closewindow", 2),
    ("The front door of the whole OS:\n"
     "- **SUPER+SPACE** opens the menu \u2014 apps, install, themes, setup\n"
     "- Type any app\u2019s name and launch it from there",
     "event", lambda ev, d: ev == "openwindow", 1),
    # Any workspace switch counts \u2014 the user may start the tour on any desk,
    # so pinning exact numbers here just breaks (learned from Luke's run).
    ("Fresh desk:\n"
     "- Press **SUPER+2** \u2014 or any number \u2014 for another workspace\n"
     "(I\u2019ll come along \u2014 I\u2019m pinned.)",
     "event", lambda ev, d: ev == "workspace", 1),
    ("A clean context for anything \u2014 one project per desk works great.\n"
     "- Hop back to the desk you came from (**SUPER+1**, or wherever)",
     "event", lambda ev, d: ev == "workspace", 1),
    ("The float trick:\n"
     "- Arrow onto a window (leave me out of it \U0001f605)\n"
     "- **SUPER+T** pops it out to float\n"
     "- **SUPER+T** again tiles it back",
     "event", lambda ev, d: ev == "changefloatingmode", 2),
    ("Last one \u2014 about me.\n"
     "- Dismiss me any time: **SUPER+W** on my window\n"
     "- Summon me back: **SUPER+H**\n"
     "Go on \u2014 close me and call me back!",
     "event", lambda ev, d: ev == "openwindow" and "127.0.0.1" in d, 1),
]
tour = {"active": False, "step": 0, "finished": False, "note": "", "hits": 0}


def _advance_if_done():
    """Complete the current step if it's a poll step whose check passes."""
    i = tour["step"]
    while i < len(TOUR) and TOUR[i][1] == "poll" and TOUR[i][2]():
        i += 1
        tour["hits"] = 0
    if i != tour["step"]:
        tour["step"] = i
        _maybe_finish()


def _maybe_finish():
    if tour["step"] >= len(TOUR):
        tour["active"] = False
        tour["finished"] = True
        tour["finished_at"] = time.time()
        st = load_learning()
        st["toured"] = True
        save_learning(st)


def tour_thread():
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    own = (own_window_address() or "").replace("0x", "")
    try:
        import socket as sk
        sigs = os.listdir(os.path.join(run, "hypr"))
        s2 = sk.socket(sk.AF_UNIX)
        s2.connect(os.path.join(run, "hypr", sigs[0], ".socket2.sock"))
        s2.settimeout(1.0)
        buf = b""
        deadline = time.time() + 900
        _advance_if_done()
        while tour["active"] and time.time() < deadline:
            try:
                chunk = s2.recv(4096)
            except OSError:
                _advance_if_done()
                continue
            if not chunk:
                break
            buf += chunk
            if len(buf) > 1_000_000:      # a line that never ends: drop it
                buf = b""
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                ev, _, d = line.decode(errors="replace").partition(">>")
                if own and ev in ("changefloatingmode", "closewindow") \
                        and own in d.replace("0x", "") \
                        and tour["step"] < len(TOUR) - 1:
                    tour["note"] = ("Careful \u2014 that one hit ME, not the "
                                    "terminal \U0001f605 Arrow your focus onto another window "
                                    "first, then try the key again. (If I ever "
                                    "look broken: SUPER+W on me, then "
                                    "SUPER+H brings me back fresh.)")
                    continue
                i = tour["step"]
                if i < len(TOUR) and TOUR[i][1] == "event" and TOUR[i][2](ev, d):
                    tour["hits"] = tour.get("hits", 0) + 1
                    if tour["hits"] >= TOUR[i][3]:
                        tour["step"] = i + 1
                        tour["hits"] = 0
                        _maybe_finish()
                    if not tour["active"]:
                        return
                _advance_if_done()
                if not tour["active"]:
                    return
        tour["active"] = False
    except Exception:
        tour["active"] = False


def load_learning():
    """Bounded, schema-checked read: a corrupt or oversized state file
    degrades to empty state instead of feeding the server garbage."""
    try:
        st = json.loads(secure_read(DATA, "learning.json", 65536))
        if not isinstance(st, dict):
            return {}
        for k in ("taught", "observed", "integrations"):
            v = st.get(k)
            if v is not None and (not isinstance(v, dict) or len(v) > 200):
                st.pop(k, None)
        return st
    except Exception:
        return {}


def save_learning(st):
    secure_write(DATA, "learning.json", json.dumps(st))


def learning_status():
    st = load_learning()
    taught = st.get("taught", {})
    observed = st.get("observed", {})
    items = []
    for fid, label, _q, obs in CURRICULUM:
        done = fid in taught or (obs and obs in observed)
        items.append({"id": fid, "label": label, "done": bool(done)})
    return st, items


def read_theme():
    """The active Omarchy theme's palette (colors.toml)."""
    try:
        import tomllib
        p = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
        return tomllib.loads(bounded_read(p, 65536).decode("utf-8", "replace"))
    except Exception:
        return {}



_facts = {"at": 0.0, "text": ""}


def machine_facts():
    """Live facts injected into every prompt so Nixi never asks what it can
    know, and answers match THIS machine."""
    if time.time() - _facts["at"] < 600 and _facts["text"]:
        return _facts["text"]
    def run(cmd):
        try:
            return run_capped(cmd, timeout=8)[1].strip()
        except Exception:
            return ""

    def _omarchy_version():
        """Omarchy's version file. On Arch it sits under ~/.local/share or
        /usr/share; on NixOS the tree is a store path, so it is resolved
        from whichever `omarchy` is actually on PATH."""
        cands = [os.path.expanduser("~/.local/share/omarchy/version"),
                 "/usr/share/omarchy/version"]
        exe = _shutil.which("omarchy")
        if exe:
            cands.insert(0, os.path.join(
                os.path.dirname(os.path.dirname(os.path.realpath(exe))), "version"))
        for c in cands:
            v = _small(c)
            if v:
                return v
        return ""

    def _small(path):
        try:
            return bounded_read(path, 4096).decode("utf-8", "replace").strip()
        except (OSError, ValueError):
            return ""
    mons = ""
    try:
        mons = "; ".join(
            f"{m['name']} {m['width']}x{m['height']}@{m['x']},{m['y']}"
            for m in json.loads(hypr("j/monitors") or "[]"))
    except Exception:
        pass
    facts = {
        "os": "nixarchy (Omarchy on NixOS)",
        "nixos": run(["nixos-version"]),
        "terminal": run(["xdg-terminal-exec", "--print-id"]) or "foot",
        "browser": run(["xdg-settings", "get", "default-web-browser"]),
        "agent": default_agent() or "none",
        "monitors": mons,
        "omarchy": _omarchy_version(),
    }
    _facts["text"] = "; ".join(f"{k}: {v}" for k, v in facts.items() if v)
    _facts["at"] = time.time()
    return _facts["text"]


lock = threading.Lock()
state = {"sid": None, "primed": ""}
history = []  # [(who, text)] session transcript, restored on widget reopen


def agent_ready():
    import shutil
    agent = default_agent()
    return agent in HEADLESS_AGENTS and bool(shutil.which(agent))


def default_agent():
    """Omarchy's chosen agent (~/.config/omarchy/defaults/agent), like the
    crash checker: the helper serves whichever agent the user picked."""
    try:
        return bounded_read(os.path.expanduser("~/.config/omarchy/defaults/agent"),
                            256).decode("utf-8", "replace").strip()
    except (OSError, ValueError):
        return ""


HEADLESS_AGENTS = ("claude", "codex")  # agents we can call inline for the chat

# DO-IT-FOR-ME mode: user-consented (button click), deliberately scoped —
# file edits plus only the commands an Omarchy config change needs. No blanket
# shell access; Codex additionally stays inside $HOME via workspace sandbox.
TRUST_FILE = "trust"   # in DATA (private state dir); legacy copy migrated once

# Two levels, and only two, so no level claims a boundary it cannot enforce:
#   guide    (default) — explains and instructs; the agent is never given a
#                        write-capable tool. Nothing on the machine changes.
#   mechanic (opt-in)  — the user's own agent with its normal working powers
#                        on its strongest model; consent per click; described
#                        honestly as unconfined.


def trust_level():
    try:
        t = secure_read(DATA, TRUST_FILE, 64).decode("utf-8", "replace").strip().lower()
        return "mechanic" if t == "mechanic" else "guide"
    except (OSError, ValueError):
        return "guide"


def save_trust(t):
    secure_write(DATA, TRUST_FILE, t + "\n")


def _migrate_legacy_trust():
    """v0.9.4 kept trust in the config dir; move it into private state.
    Any older 'fixer' value degrades to guide (fixer no longer exists)."""
    try:
        secure_read(DATA, TRUST_FILE, 64)
        return
    except (OSError, ValueError):
        pass
    try:
        t = bounded_read(os.path.join(DIR, "trust"), 64).decode().strip().lower()
        if t == "mechanic":
            save_trust(t)
    except (OSError, ValueError):
        pass


GUIDE_ONLY = ("I’m in **Guide** mode, so I explain and instruct but never "
              "change anything on your machine. If you’d like me to apply "
              "this for you, switch to **Mechanic** in the ⚙ menu — that "
              "gives your own agent its normal powers, and I’ll still ask "
              "before each fix and back up every file first.")

MECH_ALLOWED = ",".join(["Read", "Grep", "Glob", "Edit", "Write", "Bash"])
MECH_BRIEF = (
    "\n\n(The user clicked DO-IT-FOR-ME at MECHANIC trust: they explicitly "
    "consent to you making this change on their machine now, with your "
    "normal powers. Rules: prefer user-level config and sanctioned "
    "omarchy/hyprctl flows; back up EVERY file you edit first "
    "(cp X X.bak-nixi); never escalate privileges or run anything as root, "
    "never delete user data, never touch credentials or secrets. VERIFY the "
    "change took effect. Then report chat-style: what changed, how you "
    "verified it, and the one-line undo. If part of the request is dangerous "
    "or unclear, do only the safe part and say what you skipped.)")


def ask_act(q):
    """Consented action at MECHANIC trust only; Guide never reaches here."""
    agent = default_agent() or "claude"
    prompt = q + MECH_BRIEF + "\n(Machine facts: " + machine_facts() + ")"
    home = os.path.expanduser("~")
    if agent == "codex":
        rc, out, err = run_capped(
            ["codex", "exec", "--sandbox", "workspace-write", prompt],
            timeout=300, cwd=home)
        if rc != 0:
            raise RuntimeError(err.strip()[-300:] or "codex exec failed")
        return out.strip()[-2500:] or "Done (no summary returned)."
    rc, out, err = run_capped(["claude", "-p", prompt, "--output-format", "json",
                               "--allowedTools=" + MECH_ALLOWED],
                              timeout=300, cwd=home)
    if rc != 0:
        raise RuntimeError(err.strip()[-300:] or "unknown error")
    data = json.loads(out)
    return (data.get("result") or "").strip() or "Done (no summary returned)."


# ---- learning broker: the tutor never writes; it reports, the server appends
_LEARN_MARK = "LEARNED:"


def absorb_learned(answer):
    """Strip trailing 'LEARNED: ...' lines from a tutor answer and append them
    (bounded, private, atomic) to the state dir's LEARNED.md."""
    keep, learned = [], []
    for line in answer.splitlines():
        if line.strip().startswith(_LEARN_MARK):
            fact = line.strip()[len(_LEARN_MARK):].strip()[:300]
            if fact:
                learned.append(fact)
        else:
            keep.append(line)
    if learned:
        try:
            try:
                cur = secure_read(DATA, "LEARNED.md", 262144).decode("utf-8", "replace")
            except (OSError, ValueError):
                cur = "# Learned on this machine\n"
            day = time.strftime("%Y-%m-%d")
            cur += "".join(f"- {day}: {f}\n" for f in learned[:5])
            if len(cur) > 262144:                       # keep the newest
                cur = cur[-200000:]
            secure_write(DATA, "LEARNED.md", cur)
        except Exception:
            pass
    return "\n".join(keep).strip()


def ask_claude(q, resume):
    # NOTE: --allowedTools is variadic — keep the prompt ahead of it and use
    # the = form, or it swallows the prompt as a tool name.
    # A tutor needs speed, not deep reasoning: fast model on purpose.
    args = ["claude", "-p", q + STYLE.format(facts=machine_facts()), "--output-format", "json",
            "--model", "haiku", "--allowedTools=" + ALLOWED]
    if resume and state["sid"]:
        args += ["--resume", state["sid"]]
    rc, out, err = run_capped(args, timeout=240, cwd=DIR)
    if rc != 0:
        raise RuntimeError(err.strip()[-300:] or "unknown error")
    data = json.loads(out)
    state["sid"] = data.get("session_id") or state["sid"]
    return (data.get("result") or "").strip() or "Sorry — I came back empty. Try asking again."


def ask_codex(q):
    # Low reasoning effort for speed; retry plain if this codex predates it.
    prompt = q + STYLE.format(facts=machine_facts())
    # Tutoring is explicitly read-only: the sandbox is the boundary.
    rc, out, err = run_capped(["codex", "exec", "--sandbox", "read-only",
                               "-c", "model_reasoning_effort=low", prompt],
                              timeout=240, cwd=DIR)
    if rc != 0:  # older codex without the reasoning knob; same read-only sandbox
        rc, out, err = run_capped(["codex", "exec", "--sandbox", "read-only", prompt],
                                  timeout=240, cwd=DIR)
    if rc != 0:
        raise RuntimeError(err.strip()[-300:] or "unknown error")
    return out.strip()[-2000:] or "Sorry — I came back empty."


def ask_agent(q, resume):
    agent = default_agent() or "claude"
    if agent == "codex":
        return ask_codex(q)
    return ask_claude(q, resume)


# ---- voice input ----------------------------------------------------------
# Push-to-talk, captured by the DESKTOP rather than by the browser.
#
# Two things ruled out the browser. The SpeechRecognition API streams raw
# microphone audio to Google and is a silent no-op on any Chromium built
# without Google API keys (nixpkgs' has none), so it would have worked only
# for users who happen to run Google Chrome. Recording in the page with
# MediaRecorder fixed that, but still made voice depend on which browser
# opened the widget, on a permission prompt inside a 342x480 pinned window,
# and on transcoding whatever container that browser chose.
#
# pw-record needs nothing but XDG_RUNTIME_DIR, uses the input device the
# desktop is already configured to use, and writes 16 kHz mono s16 -- which
# is exactly what whisper wants, so there is no transcode step at all.
VOICE_MODEL = os.path.expanduser(os.environ.get(
    "NIXI_WHISPER_MODEL", os.path.join(DATA, "models", "ggml-base.en.bin")))
VOICE_LANG = os.environ.get("NIXI_WHISPER_LANG", "en")
# Every one of these is a word a user of this widget says constantly and a
# general speech model has never seen: base.en hears "nixarchy" as "Nixaki".
# An initial prompt biases the decoder towards the vocabulary of the domain.
VOICE_PROMPT = os.environ.get("NIXI_WHISPER_PROMPT", (
    "Words used here: nixarchy, Omarchy, NixOS, Nixi, Hyprland, Waybar, "
    "flake, nix, nixpkgs, home-manager, systemd, keybinding, TUI, sudo, "
    "rebuild, generation, rollback, derivation, dotfiles, workspace."))
MAX_SECONDS = 60
# Whisper does not return nothing when it hears nothing -- it INVENTS. Digital
# silence decodes as " You", a quiet room as "(wind howling)" or a whole
# fabricated sentence. A made-up question in the input box is indistinguishable
# from one the user really asked, so no-speech has to be caught.
#
# It is caught by Silero VAD, NOT by a loudness threshold. The first version of
# this shipped an RMS gate at 1100 and it was simply wrong: whisper normalises
# internally and transcribes the same sentence correctly at RMS 576, 288, 138,
# 69 and 34. Level is nearly irrelevant to it. All the gate did was discard
# audio whisper handles fine -- on a real machine the user spoke, was heard at
# roughly RMS 780, and got back an empty string.
#
# VAD keeps quiet speech at every one of those levels and empties both digital
# silence and a real quiet room. What remains here is a dead-microphone check
# only: a muted or absent input device gives essentially zero signal, and that
# is worth naming rather than sending to a model.
SILENCE_RMS = int(os.environ.get("NIXI_VOICE_SILENCE_RMS", "15"))
VOICE_VAD_MODEL = os.path.expanduser(os.environ.get(
    "NIXI_VAD_MODEL", os.path.join(DATA, "models", "ggml-silero-v5.1.2.bin")))
voice_lock = threading.Lock()
_rec = {"proc": None, "path": None, "timer": None}


def voice_ready():
    """(ok, reason). Every missing piece is named: a mic button that does
    nothing, with nothing logged, is the failure mode this project keeps
    hitting (the Lua window rule, the unfetched manual)."""
    missing = [b for b in ("whisper-cli", "pw-record") if not _shutil.which(b)]
    if missing:
        return False, ("Voice needs " + " and ".join(missing) + " on PATH. On "
                       "nixarchy/NixOS set services.nixi.voice.enable = true; "
                       "elsewhere install whisper-cpp and pipewire.")
    if not os.path.isfile(VOICE_MODEL):
        return False, ("No speech model at " + VOICE_MODEL + " \u2014 fetch one with: "
                       "whisper-cpp-download-ggml-model base.en "
                       + os.path.dirname(VOICE_MODEL))
    return True, ""


def _new_clip():
    """An O_EXCL 0600 file under $DATA, created through a validated directory
    descriptor like every other private file here, then handed to pw-record
    by path (it opens the file itself). /tmp is not an option: _dirfd refuses
    anything outside $HOME, and a world-readable recording is not private."""
    vdir = os.path.join(DATA, "voice")
    dfd = _dirfd(vdir, create=True)
    try:
        name = "clip." + secrets.token_hex(8) + ".wav"
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
                     | os.O_CLOEXEC, 0o600, dir_fd=dfd)
        os.close(fd)
        return os.path.join(vdir, name)
    finally:
        os.close(dfd)


def _stop_proc():
    """SIGTERM, not SIGKILL: pw-record rewrites the RIFF length header as it
    exits, and a killed recorder leaves a WAV nothing can read."""
    proc = _rec["proc"]
    if proc is None:
        return
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=5)
    _rec["proc"] = None
    if _rec["timer"] is not None:
        _rec["timer"].cancel()
        _rec["timer"] = None


def _discard():
    """Watchdog: the widget can be closed, crash, or lose its connection
    mid-recording. Without this the microphone would stay open forever."""
    with voice_lock:
        _stop_proc()
        path = _rec["path"]
        _rec["path"] = None
    if path:
        try:
            os.unlink(path)
        except OSError:
            pass


def start_recording():
    with voice_lock:
        if _rec["proc"] is not None and _rec["proc"].poll() is None:
            raise ValueError("already recording")
        path = _new_clip()
        proc = subprocess.Popen(
            ["pw-record", "--rate", "16000", "--channels", "1",
             "--format", "s16", path],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL)
        timer = threading.Timer(MAX_SECONDS, _discard)
        timer.daemon = True
        timer.start()
        _rec.update(proc=proc, path=path, timer=timer)


def stop_recording():
    with voice_lock:
        if _rec["proc"] is None:
            raise ValueError("not recording")
        _stop_proc()
        path = _rec["path"]
        _rec["path"] = None
    try:
        return transcribe(path)          # (text, note)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


def _rms(path):
    """Root-mean-square level, 0-32767. array rather than audioop, which was
    removed from the standard library in Python 3.13."""
    with wave.open(path, "rb") as w:
        if w.getsampwidth() != 2:
            return None
        frames = w.readframes(min(w.getnframes(), 16000 * MAX_SECONDS))
    samples = array.array("h")
    samples.frombytes(frames[:len(frames) - (len(frames) % 2)])
    if not samples:
        return 0
    return math.sqrt(sum(x * x for x in samples) / len(samples))


def transcribe(path):
    """Returns (text, note). An empty text ALWAYS comes with a note saying
    why: an empty string on its own is indistinguishable from 'you said
    nothing', 'your mic is muted' and 'the gate ate it', which is exactly how
    the first version of this failed invisibly on a real machine."""
    try:
        level = _rms(path)
    except (wave.Error, EOFError):
        raise ValueError("that recording was not readable audio") from None
    if level is not None and level < SILENCE_RMS:
        return "", ("Your microphone produced no signal at all (level %.0f). "
                    "Check it is not muted: SUPER+SPACE \u2192 Audio, or "
                    "wpctl get-volume @DEFAULT_AUDIO_SOURCE@." % level)
    cmd = ["whisper-cli", "-m", VOICE_MODEL, "-l", VOICE_LANG, "-nt", "-np",
           "--prompt", VOICE_PROMPT,
           "-t", str(min(8, os.cpu_count() or 4))]
    # Without VAD, a clip with no speech in it comes back as invented text.
    if os.path.isfile(VOICE_VAD_MODEL):
        cmd += ["--vad", "--vad-model", VOICE_VAD_MODEL]
    try:
        out = subprocess.run(cmd + [path], check=True, timeout=120,
                             capture_output=True, text=True).stdout
    except subprocess.CalledProcessError:
        # Raising the CalledProcessError would put the whole argv, and the
        # user's home path, in a chat bubble. Say the useful thing instead.
        raise ValueError("the speech model failed on that clip") from None
    # -nt still emits whole-line markers for silence ("[BLANK_AUDIO]") and
    # pads every segment; a line that is nothing but brackets is never speech.
    lines = [ln.strip() for ln in out.splitlines()]
    keep = [ln for ln in lines
            if ln and not (ln.startswith("[") and ln.endswith("]"))]
    text = " ".join(keep).strip()[:2000]
    if text:
        return text, ""
    if os.path.isfile(VOICE_VAD_MODEL):
        return "", ("I heard the recording (level %.0f) but no speech in it." % level)
    return "", ("No speech found (level %.0f). Speech detection is off because "
                "there is no VAD model at %s -- without it I have to discard "
                "anything I am unsure about." % (level, VOICE_VAD_MODEL))


# ---- feature-specific consent for persistent integrations ----------------
# The bar click installs only the core (widget, server, menu entry). Each
# persistent extra is enabled from inside the widget, one explicit decision
# per feature, applied by the installer (install.py) under supervision.
SETUP_FEATURES = {
    "watcher": ("Coaching watcher",
                "A background service that watches which nixarchy features you "
                "use and offers at most one tip a day. Nothing leaves the machine."),
    "skill": ("Agent skill",
              "Installs Nixi\u2019s tutor method into ~/.claude/skills so your "
              "agent answers the Nixi way even outside this widget."),
    "hooks": ("Boot & update hooks",
              "A one-time first-boot welcome, a manual refresh after each "
              "omarchy-update, and a weekly refresh timer."),
}


def _source_root():
    """Where the plugin source lives (recorded by install.py at core
    install); validated before anything is run from it."""
    try:
        p = secure_read(DATA, "source_root", 4096).decode("utf-8", "replace").strip()
    except (OSError, ValueError):
        return None
    if not p.startswith("/"):
        return None
    try:
        st = os.stat(p)
    except OSError:
        return None
    if not _dir_ok(st):
        return None
    if not os.path.isfile(os.path.join(p, "install.py")):
        return None
    return p


def setup_status():
    st = load_learning()
    root = _source_root()
    installed = {}
    if root:
        try:
            _, out, _ = run_capped([sys.executable, os.path.join(root, "install.py"),
                                    "--status"], timeout=30, cwd=root)
            installed = json.loads(out)
            if not isinstance(installed, dict):
                installed = {}
        except Exception:
            installed = {}
    return {"available": bool(root),
            "dismissed": bool(st.get("setup_dismissed")),
            "features": [{"id": k, "label": v[0], "desc": v[1],
                          "installed": bool(installed.get(k))}
                         for k, v in SETUP_FEATURES.items()]}


def setup_apply(feature, enable):
    root = _source_root()
    if not root:
        return False, "install source not available"
    flag = ("--with-" if enable else "--without-") + feature
    try:
        rc, out, err = run_capped([sys.executable, os.path.join(root, "install.py"),
                                   flag], timeout=180, cwd=root)
    except Exception as e:
        return False, str(e)[-300:]
    if rc != 0:
        return False, (err.strip() or out.strip())[-300:] or "installer failed"
    st = load_learning()
    st.setdefault("integrations", {})[feature] = bool(enable)
    save_learning(st)
    return True, out.strip()[-300:]


class Handler(http.server.BaseHTTPRequestHandler):
    timeout = 30            # socket timeout: a stalled request can't pin a thread
    protocol_version = "HTTP/1.0"

    def log_message(self, *a):
        pass

    def _guard(self, need_token):
        """Host/Origin allowlist against DNS rebinding; per-session token on
        every state-changing request. Returns True when the request may
        proceed (an error response has been sent otherwise)."""
        if _peer_uid(self.client_address[1]) != _UID:
            self._send(403, {"error": "not your session"})
            return False
        host = (self.headers.get("Host") or "").strip().lower()
        if host not in _HOSTS:
            self._send(403, {"error": "bad host"})
            return False
        origin = self.headers.get("Origin")
        if origin and origin.strip().lower() not in _ORIGINS:
            self._send(403, {"error": "bad origin"})
            return False
        if need_token and not secrets.compare_digest(
                self.headers.get("X-Nixi-Token", ""), TOKEN):
            self._send(403, {"error": "missing capability token"})
            return False
        return True

    def _read_json(self, limit=16384):
        """Bounded JSON body: fixed small cap, no chunked encoding, JSON
        content type only (non-simple, so browsers must preflight it)."""
        if self.headers.get("Transfer-Encoding"):
            raise ValueError("chunked")
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        if ctype != "application/json":
            raise ValueError("content type")
        n = int(self.headers.get("Content-Length"))
        if n < 0 or n > limit:
            raise ValueError("length")
        return json.loads(self.rfile.read(n))

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        public = self.path in _PUBLIC_GET or self.path.startswith("/vendor/")
        if not self._guard(need_token=not public):
            return
        if self.path in ("/", "/index.html"):
            try:
                html = bounded_read(UI, 1_000_000).decode("utf-8", "replace")
            except (OSError, ValueError):
                return self._send(500, {"error": "ui missing"})
            html = html.replace("__TOKEN__", TOKEN)
            t = read_theme()
            if t.get("background"):
                light = t.get("mode") == "light"
                css = ":root{" + "".join(
                    f"{k}:{v};" for k, v in {
                        "--bg": t.get("background"),
                        "--panel": (t.get("darker_background") if light else t.get("dark_background"))
                                   or t.get("dark_background") or t.get("background"),
                        "--line": t.get("muted") or t.get("selection") or "#555",
                        "--ink": t.get("foreground"),
                        "--muted": t.get("dark_foreground") or t.get("muted"),
                        "--ember": t.get("accent") or t.get("blue") or "#ffb454",
                        "--bot": t.get("lighter_background") or t.get("selection"),
                        "--me": t.get("selection") or t.get("lighter_background"),
                        "--on-accent": "#ffffff" if light else (t.get("darker_background") or "#111"),
                    }.items() if v) + "}"
                html = html.replace("/*__THEME__*/", css)
            if agent_ready():
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Nixi \u2744 your nixarchy helper. Ask me "
                    "anything \u2014 I know this machine inside out. New to "
                    "nixarchy? Hit \U0001f680 and I\u2019ll walk you through it "
                    "live. And when something needs changing, I don\u2019t just "
                    "explain the fix \u2014 I can make it for you.")
                html = html.replace("__HINT__",
                    "your AI \u00b7 grounded in this machine \u00b7 \u2699 sets "
                    "what I may change")
            else:
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Nixi \u2744 your nixarchy guide. No AI agent is "
                    "connected yet \u2014 tap a quick answer below to get going "
                    "(\u201cSet up your AI agent\u201d unlocks the full chat, and "
                    "then I can fix things for you, not just explain them).")
                html = html.replace("__HINT__",
                    "quick answers work offline \u00b7 connect an agent for everything else")
            self._send(200, html.encode(), "text/html")
        elif self.path.startswith("/vendor/"):
            name = os.path.basename(self.path)
            p = os.path.join(DIR, "vendor", name)
            if name.endswith(".js"):
                try:
                    return self._send(200, bounded_read(p, 2_000_000), "application/javascript")
                except (OSError, ValueError):
                    pass
            return self._send(404, {"error": "not found"})
        elif self.path == "/health":
            self._send(200, {"ok": True})
        elif self.path == "/faq":
            # The starter chips are onboarding: shown only while no AI agent
            # is connected (Luke: with an agent they're clutter).
            entries = []
            for p in (os.path.join(DIR, "faq.json"), os.path.join(DATA, "faq.json")):
                if os.path.exists(p):
                    try:
                        entries = json.loads(bounded_read(p, 262144))
                        if not isinstance(entries, list):
                            entries = []
                        entries = entries[:40]
                    except Exception:
                        pass
                    break
            return self._send(200, {"ready": agent_ready(), "faq": entries})
        elif self.path == "/prime":
            q = state.pop("primed", "")
            self._send(200, {"q": q})
        elif self.path == "/tour/state":
            note = tour.pop("note", "") if tour.get("note") else ""
            self._send(200, {"active": tour["active"], "step": tour["step"],
                             "finished": tour["finished"], "note": note,
                             "fresh_finish": time.time() - tour.get("finished_at", 0) < 120,
                             "steps": [t[0] for t in TOUR]})
        elif self.path == "/history":
            self._send(200, {"turns": history[-40:]})
        elif self.path == "/learn":
            _, items = learning_status()
            self._send(200, {"items": items,
                             "done": sum(1 for i in items if i["done"]),
                             "total": len(items),
                             "toured": load_learning().get("toured", False)})
        elif self.path == "/status":
            self._send(200, {"window": bool(own_window_address())})
        elif self.path == "/setup":
            self._send(200, setup_status())
        elif self.path == "/trust":
            self._send(200, {"trust": trust_level()})
        elif self.path == "/voice":
            ok, why = voice_ready()
            self._send(200, {"ok": ok, "reason": why})
        elif self.path == "/theme":
            self._send(200, read_theme())
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if not self._guard(need_token=True):
            return
        if self.path == "/prepare":
            # The launcher is about to open the widget window: apply the
            # float/pin placement rule (a compositor-state change, hence POST).
            ensure_window_rule()
            return self._send(200, {"ok": True})
        if self.path == "/setup":
            try:
                body = self._read_json()
                feat = str(body.get("feature", ""))
                enable = bool(body.get("enable", True))
            except Exception:
                return self._send(400, {"error": "bad request"})
            if feat not in SETUP_FEATURES:
                return self._send(400, {"error": "unknown feature"})
            with lock:
                ok, msg = setup_apply(feat, enable)
            return self._send(200 if ok else 500, {"ok": ok, "msg": msg,
                                                   "status": setup_status()})
        if self.path == "/setup/dismiss":
            st = load_learning()
            st["setup_dismissed"] = True
            save_learning(st)
            return self._send(200, {"ok": True})
        if self.path == "/tour/start":
            tour.update({"active": True, "step": 0, "finished": False, "note": "", "hits": 0})
            threading.Thread(target=tour_thread, daemon=True).start()
            return self._send(200, {"ok": True, "steps": [t[0] for t in TOUR]})
        if self.path == "/tour/stop":
            tour["active"] = False
            return self._send(200, {"ok": True})
        if self.path == "/learn/next":
            st, items = learning_status()
            nxt = next((i for i in items if not i["done"]), None)
            if nxt is None:
                return self._send(200, {"q": "", "msg": "You've explored the whole path \U0001f393"})
            q = next(qq for fid, _, qq, _ in CURRICULUM if fid == nxt["id"])
            st.setdefault("taught", {})[nxt["id"]] = time.time()
            save_learning(st)
            return self._send(200, {"q": q, "label": nxt["label"]})
        if self.path == "/toured":
            st = load_learning()
            st["toured"] = True
            save_learning(st)
            return self._send(200, {"ok": True})
        if self.path == "/prime":
            # A teaching question queued by the tip watcher: the widget asks
            # it automatically the next time it becomes visible.
            try:
                state["primed"] = str(self._read_json().get("q", ""))[:500]
            except Exception:
                return self._send(400, {"error": "bad request"})
            return self._send(200, {"ok": True})
        if self.path == "/trust":
            try:
                t = str(self._read_json().get("trust", "")).strip().lower()
            except Exception:
                return self._send(400, {"error": "bad request"})
            if t not in ("guide", "mechanic"):
                return self._send(400, {"error": "guide or mechanic"})
            save_trust(t)
            return self._send(200, {"trust": t})
        if self.path == "/open":
            # Click-to-open: file paths in Nixi's answers are links. Only
            # launches the sanctioned editor flow on an existing file under
            # known roots -- never executes anything from the path itself.
            try:
                p = str(self._read_json().get("path", ""))[:500]
            except Exception:
                return self._send(400, {"error": "bad request"})
            p = os.path.realpath(os.path.expanduser(p.replace("$HOME", "~")))
            home = os.path.expanduser("~")
            roots = (home + "/", "/etc/", "/usr/", "/opt/", "/var/", "/srv/", "/tmp/")
            if p.startswith(roots) and os.path.isfile(p):
                spawn_detached(["omarchy-launch-config-editor", p])
                return self._send(200, {"ok": True})
            spawn_detached(["omarchy-notification-send", "Nixi",
                            "Can\u2019t open " + p[:200] +
                            " \u2014 it doesn\u2019t exist (yet?)"])
            return self._send(200, {"ok": False})
        if self.path == "/show":
            # Pinned widget is always visible when open; just focus it.
            addr, cls = own_window()
            if addr and cls:
                try:
                    run_capped(["omarchy-launch-or-focus", cls, "true"], timeout=10)
                except Exception:
                    pass
            return self._send(200, {"ok": True})
        if self.path == "/minimize":
            # Nixi is a PINNED widget (visible on every workspace); hiding
            # means closing the window — the chat survives server-side and is
            # restored on reopen. Targeted close: focus it, close the active.
            addr, cls = own_window()
            if addr and cls:
                try:
                    run_capped(["omarchy-launch-or-focus", cls, "true"], timeout=10)
                except Exception:
                    pass
                time.sleep(0.3)
                if own_window_address() == addr:   # still there and focused
                    hypr("dispatch hl.dsp.window.close()")
            return self._send(200, {"ok": bool(addr)})
        if self.path in ("/listen/start", "/listen/stop"):
            ok, why = voice_ready()
            if not ok:
                return self._send(200, {"error": why})
            if self.path == "/listen/start":
                try:
                    start_recording()
                except ValueError as e:
                    return self._send(200, {"error": str(e)})
                except Exception as e:
                    return self._send(200, {"error": "could not open the microphone: "
                                            + str(e)[-200:]})
                return self._send(200, {"recording": True})
            try:
                text, note = stop_recording()
            except ValueError as e:
                return self._send(200, {"error": str(e)})
            except subprocess.TimeoutExpired:
                return self._send(200, {"error": "transcription timed out"})
            except Exception as e:
                return self._send(200, {"error": "could not transcribe: " + str(e)[-200:]})
            return self._send(200, {"text": text, "note": note})
        if self.path != "/ask":
            return self._send(404, {"error": "not found"})
        try:
            body = self._read_json()
            q = str(body.get("q", "")).strip()[:2000]
            force = body.get("force")
            ephemeral = bool(body.get("ephemeral"))
        except Exception:
            return self._send(400, {"error": "bad request"})
        if not q:
            return self._send(400, {"error": "empty"})

        agent = default_agent()
        have_ai = agent_ready()
        if not have_ai:
            hint = ("No AI agent is connected yet. nixarchy is AI-first: pick "
                    "your coding agent once with SUPER+SPACE \u2192 Setup \u2192 "
                    "Default agent (or: omarchy default agent claude), sign in "
                    "to it, and I\u2019ll answer anything. The Getting-started "
                    "buttons above work without one.")
            if agent and agent not in HEADLESS_AGENTS:
                hint = (f"Your default agent is \u2018{agent}\u2019, which I can\u2019t "
                        "chat through inline yet (Claude Code and Codex work). "
                        "Switch with: omarchy default agent claude \u2014 or use "
                        "SUPER+A for a full agent session.")
            return self._send(200, {"a": hint, "src": "manual"})

        if force == "act":
            if trust_level() != "mechanic":
                return self._send(200, {"a": GUIDE_ONLY, "src": "ai"})
            plan = str(body.get("plan", ""))[:700]
            aq = q + ("\n(Your earlier advice was: " + plan + ")" if plan else "")
            with lock:
                try:
                    answer = ask_act(aq)
                except subprocess.TimeoutExpired:
                    answer = ("That change took too long — nothing may have "
                              "been applied; ask me to check.")
                except Exception as e:
                    answer = "I hit a snag acting on that: " + str(e)[-300:]
            if not ephemeral:
                history.append(("me", "\U0001f527 " + q))
                history.append(("bot", answer))
                del history[:-200]
            return self._send(200, {"a": answer, "src": "act"})

        # Ground every AI question locally first: with the matching manual
        # excerpt and keybindings already in the prompt, the agent can usually
        # answer without spawning tool calls — the main latency saver.
        context = local_answer(q)
        prompt = q
        if context:
            prompt += ("\n\n(Local search context — answer directly from this "
                       "when it suffices, verify live only if it doesn't:\n"
                       + context[:1200] + ")")
        with lock:
            try:
                answer = ask_agent(prompt, resume=True)
            except subprocess.TimeoutExpired:
                answer = "That took too long — try a simpler question."
            except Exception:
                # A stale/broken session shouldn't kill the chat: retry fresh.
                state["sid"] = None
                try:
                    answer = ask_agent(prompt, resume=False)
                except Exception as e:
                    answer = "I hit a snag: " + str(e)[-300:]
        answer = absorb_learned(answer)
        if not ephemeral:
            history.append(("me", q))
            history.append(("bot", answer))
            del history[:-200]
        self._send(200, {"a": answer, "src": "ai"})


if __name__ == "__main__":
    _repair_private_modes()
    _write_token()
    _migrate_legacy_trust()
    signal.signal(signal.SIGTERM, _shutdown)
    signal.signal(signal.SIGINT, _shutdown)
    try:
        ensure_window_rule()
    except Exception:
        pass
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.daemon_threads = True
    try:
        server.serve_forever()
    finally:
        _shutdown()
