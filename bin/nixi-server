def hypr(cmd):
    """Send one command to the Hyprland socket (works even when the server
    was started outside the session env)."""
    import socket as sk
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        sigs = os.listdir(os.path.join(run, "hypr"))
        sig = sigs[0] if sigs else None
    if not sig:
        return ""
    s = sk.socket(sk.AF_UNIX)
    s.settimeout(5.0)
    s.connect(os.path.join(run, "hypr", sig, ".socket.sock"))
    s.sendall(cmd.encode())
    chunks, total = [], 0
    try:
        while total < 4_000_000:           # j/clients can exceed one recv
            b = s.recv(65536)
            if not b:
                break
            chunks.append(b)
            total += len(b)
    except OSError:
        pass
    s.close()
    return b"".join(chunks).decode("utf-8", "replace")


_rule = {"at": 0.0}


def ensure_window_rule():
    """Float/pin the widget bottom-right for ANY chromium-family browser
    (class = <browser>-127.0.0.1__...). Injected at runtime via the shell's
    eval channel: no user config files touched, reapplied cheaply since a
    Hyprland reload clears runtime rules. Throttled to avoid stacking."""
    if time.time() - _rule["at"] < 600:
        return
    _rule["at"] = time.time()
    # Pixel-matched to the shell's popout panels (346 visual width, 2px
    # inset). Hyprland draws a 2px border OUTSIDE the window box, so the
    # window itself is 342 wide. Bar at the bottom: popouts open bottom-right
    # there, so Nixi moves to the bottom-LEFT and rises to clear the bar.
    x, y = "(monitor_w-346)", "(monitor_h-488)"
    try:
        cfg = json.loads(bounded_read(os.path.expanduser("~/.config/omarchy/shell.json"), 1_000_000))
        if (cfg.get("bar") or {}).get("position") == "bottom":
            x, y = "4", "(monitor_h-518)"
    except Exception:
        pass
    # The class pattern goes into Lua as a LONG string ([[...]]): inside a
    # quoted Lua string `\.` is an invalid escape and Hyprland rejects the
    # whole rule ("invalid escape sequence"), which silently left the widget
    # tiled instead of a pinned corner panel.
    hypr('eval hl.window_rule({ match = { class = [[^.*-127\\.0\\.0\\.1__.*$]] }, '
         'float = true, pin = true, size = { 342, 480 }, '
         'move = { "' + x + '", "' + y + '" } })')


def own_window():
    """(address, class) of the widget window, whichever browser hosts it."""
    try:
        data = json.loads(hypr("j/clients") or "[]")
    except ValueError:
        return None, None
    for c in data:
        if "127.0.0.1" in c.get("class", ""):
            return c.get("address"), c.get("class")
    return None, None


def own_window_address():
    return own_window()[0]
# ---------------------------------------------------------------- tier 1
# Offline answers: a tiny full-text index over the bundled manual, the
# knowledge file, and the machine's live keybindings. No LLM required.
import re as _re

_WORD = _re.compile(r"[a-zA-Z][a-zA-Z0-9+\-]{1,}")
_STOP = set("the a an and or of to in on for with how do i does what is are my "
            "you your it this that can where when omarchy use using used why "
            "work works working different way ways get set new want would "
            "should could there some more make makes".split())


def _tokens(text):
    out = []
    for w in _WORD.findall(text):
        w = w.lower()
        if w in _STOP:
            continue
        # cheap stemming so app/apps, theme/themes, keybinding/keybindings meet
        if len(w) > 3 and w.endswith("s") and not w.endswith("ss"):
            w = w[:-1]
        out.append(w)
    return out


def _sections():
    docs = []
    for base, tag in ((os.path.join(DATA, "manual"), "manual"),
                      (DIR, "notes"), (DATA, "notes")):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".md"):
                continue
            if tag == "notes" and name not in ("KNOWLEDGE.md", "LEARNED.md", "LOCAL.md"):  # noqa
                continue
            try:
                text = bounded_read(os.path.join(base, name), 524288).decode("utf-8", "replace")
            except (OSError, ValueError):
                continue
            fname_words = " ".join(name[:-3].split("-"))
            for part in _re.split(r"\n(?=#{1,3} )", text):
                lines = part.strip().splitlines()
                if not lines:
                    continue
                head = (lines[0].lstrip("# ").strip() or name) + " " + fname_words
                body = "\n".join(lines[1:]).strip()
                if body:
                    docs.append((f"{head}", body, tag))
    return docs


def _keybinds():
    try:
        _, out, _ = run_capped(["omarchy", "menu", "keybindings", "--print"],
                               timeout=10)
        return out
    except Exception:
        return ""


_index = {"sig": None, "docs": []}


def _index_sig():
    sig = []
    for base in (os.path.join(DATA, "manual"), DIR, DATA):
        try:
            for n in os.listdir(base):
                if n.endswith(".md"):
                    sig.append((n, os.path.getmtime(os.path.join(base, n))))
        except OSError:
            pass
    return tuple(sorted(sig))


def get_index():
    sig = _index_sig()
    if sig != _index["sig"]:
        _index["docs"] = _sections()
        _index["sig"] = sig
    return _index["docs"]


def local_answer(q):
    """Best-matching manual/knowledge section for q, or None."""
    qt = _tokens(q)
    if not qt:
        return None
    qset = set(qt)
    best, score = None, 0.0
    for head, body, tag in get_index():
        ht, bt = _tokens(head), _tokens(body)
        if not bt:
            continue
        hmatch = len(qset & set(ht))
        s = 3.0 * hmatch                            # title/filename hits: undamped
        if hmatch and ht:
            s += 1.5 * hmatch / len(set(ht))        # focused titles beat long ones
        freq = sum(min(bt.count(w), 3) for w in qset)   # repeated terms matter
        s += freq / (1 + 0.02 * len(bt))
        if s > score:
            best, score = (head, body, tag), s
    # keybinding questions: grep the live bindings too
    kb_hit = ""
    if any(w in qset for w in ("key", "keys", "shortcut", "keybinding", "bind",
                               "super", "press", "hotkey")):
        kb = _keybinds()
        hits = [l for l in kb.splitlines()
                if any(w in l.lower() for w in qt)][:4]
        kb_hit = "\n".join(hits)
    if score < 3.8 and not kb_hit:
        return None
    parts = []
    if best:
        body = best[1]
        body = body if len(body) <= 700 else body[:700].rsplit(" ", 1)[0] + " …"
        parts.append(f"From the {'manual' if best[2] == 'manual' else 'notes'} — {best[0]}:\n{body}")
    if kb_hit:
        parts.append("Your live keybindings say:\n" + kb_hit)
    return "\n\n".join(parts)


