#!/usr/bin/env python3
"""Omarchy Helper micro-server: serves the chat widget UI and relays each
message to a headless Claude Code call (with read-only grounding tools).
Local only (127.0.0.1), stdlib only, no telemetry."""
import http.server
import json
import os
import subprocess
import threading

PORT = int(os.environ.get("OMARCHY_HELP_PORT", "8642"))
DIR = os.path.expanduser(os.environ.get("OMARCHY_HELP_DIR", "~/.config/omarchy-help"))
UI = os.path.join(DIR, "ui.html")
ALLOWED = ",".join([
    "Read", "Grep", "Glob",
    "Bash(omarchy menu keybindings --print)",
    "Bash(hyprctl binds)", "Bash(hyprctl clients)", "Bash(hyprctl workspaces)",
    "Bash(ls /usr/share/omarchy/bin)",
])
STYLE = ("\n\n(Answer for a chat bubble: plain text, no markdown headings, "
         "max ~90 words unless asked for more.)")
lock = threading.Lock()
state = {"first": True}


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self._send(200, open(UI, "rb").read(), "text/html")
        elif self.path == "/health":
            self._send(200, {"ok": True})
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if self.path != "/ask":
            return self._send(404, {"error": "not found"})
        n = int(self.headers.get("Content-Length", 0))
        try:
            q = json.loads(self.rfile.read(n)).get("q", "").strip()[:2000]
        except Exception:
            return self._send(400, {"error": "bad request"})
        if not q:
            return self._send(400, {"error": "empty"})
        with lock:
            args = ["claude", "-p"]
            if not state["first"]:
                args.append("--continue")
            args += ["--allowedTools", ALLOWED, q + STYLE]
            try:
                out = subprocess.run(args, cwd=DIR, capture_output=True,
                                     text=True, timeout=240)
                state["first"] = False
                answer = out.stdout.strip() or "Sorry — I came back empty. Try asking again."
                if out.returncode != 0:
                    answer = "I hit a snag: " + (out.stderr.strip()[-300:] or "unknown error")
            except subprocess.TimeoutExpired:
                answer = "That took too long — try a simpler question."
        self._send(200, {"a": answer})


if __name__ == "__main__":
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.serve_forever()
