    ("workspaces", "Workspaces", "How do I use workspaces? Teach me the basics briefly.", "workspaces"),
    ("movewindows", "Moving windows", "How do I move and swap windows with the keyboard?", None),
    ("scratchpad", "The scratchpad", "What is the scratchpad and how do I use it?", "scratchpad"),
    ("webapps", "Websites as apps", "How do I turn a website into an app with its own window and icon?", "webapps"),
    ("install", "Installing software", "How do I install and remove apps, including from the AUR?", None),
    ("floating", "Floating windows", "How do I make a window float, move and resize it?", "floating"),
    ("fullscreen", "Full screen modes", "What are the fullscreen and maximize keys and when do I use each?", "fullscreen"),
    ("themes", "Themes", "How do I change the theme and background, and install new themes?", None),
    ("capture", "Screenshots and OCR", "How do I take screenshots and grab text from the screen?", None),
    ("update", "Staying updated", "How do I keep Omarchy updated and what happens during an update?", None),
    ("agents", "Your AI agent", "What can my default AI agent do across Omarchy, like diagnosing crashes?", None),
    ("config", "Customizing safely", "How do I customize Omarchy safely so updates never break my changes?", None),
]


# ---- the LIVE tour: Archy instructs, the event socket confirms ----------
# Steps chosen so every action is verifiable from socket2 AND safe while the
# widget overlay is visible (no other special workspace involved).
TOUR = [
    # (instruction, kind, matcher, count). Texts are structured for the
    # widget's renderer: lead line + "- " bullets + **bold** keys.
    ("**SUPER** is the Windows key (\u229e, next to ALT \u2014 \u2318 on a Mac).\n"
     "It runs this whole OS. First: connect your AI.\n"
     "- Press **SUPER+SPACE**\n"
     "- Go to **Setup \u2192 Default agent**\n"
     "- Pick one (Claude Code, Codex\u2026)",
     "poll", lambda: bool(default_agent()), 1),
    ("Now the essentials.\n"
     "- **SUPER+RETURN** opens a terminal \u2014 try it\n"
     "Bonus: **SUPER+C / SUPER+V** copy-paste works everywhere, even in there.",
     "event", lambda ev, d: ev == "openwindow" and any("," + x + "," in "," + d.lower() + "," for x in ("foot", "alacritty", "kitty", "com.mitchellh.ghostty", "ghostty")), 1),
    ("Your browser has its own key.\n"
     "- Press **SUPER+SHIFT+RETURN**",
     "event", lambda ev, d: ev == "openwindow" and any(
         b in d.lower() for b in ("brave", "chromium", "firefox", "helium")), 1),
    ("One more terminal: **SUPER+RETURN**.\n"
     "Watch the windows share the screen evenly \u2014 no overlap, no dragging.\n"
     "That\u2019s tiling.",
     "event", lambda ev, d: ev == "openwindow" and any("," + x + "," in "," + d.lower() + "," for x in ("foot", "alacritty", "kitty", "com.mitchellh.ghostty", "ghostty")), 1),
    ("The move that kills the mouse:\n"
     "- **SUPER+arrows** jump focus between panes\n"
     "Bounce around a few times \u2014 watch the highlight travel.",
     "event", lambda ev, d: ev == "activewindow", 4),
    ("Time to tidy up:\n"
     "- Steer onto a window with **SUPER+arrows**\n"
     "- **SUPER+W** closes it \u2014 no titlebar needed\n"
     "Close TWO of them.",
     "event", lambda ev, d: ev == "closewindow", 2),
    ("The front door of the whole OS:\n"
     "- **SUPER+SPACE** opens the menu \u2014 apps, install, themes, setup\n"
     "- Type any app\u2019s name and launch it from there",
     "event", lambda ev, d: ev == "openwindow", 1),
    # Any workspace switch counts \u2014 the user may start the tour on any desk,
    # so pinning exact numbers here just breaks (learned from Luke's run).
    ("Fresh desk:\n"
     "- Press **SUPER+2** \u2014 or any number \u2014 for another workspace\n"
     "(I\u2019ll come along \u2014 I\u2019m pinned.)",
     "event", lambda ev, d: ev == "workspace", 1),
    ("A clean context for anything \u2014 one project per desk works great.\n"
     "- Hop back to the desk you came from (**SUPER+1**, or wherever)",
     "event", lambda ev, d: ev == "workspace", 1),
    ("The float trick:\n"
     "- Arrow onto a window (leave me out of it \U0001f605)\n"
     "- **SUPER+T** pops it out to float\n"
     "- **SUPER+T** again tiles it back",
     "event", lambda ev, d: ev == "changefloatingmode", 2),
    ("Last one \u2014 about me.\n"
     "- Dismiss me any time: **SUPER+W** on my window\n"
     "- Summon me back: **SUPER+H**\n"
     "Go on \u2014 close me and call me back!",
     "event", lambda ev, d: ev == "openwindow" and "127.0.0.1" in d, 1),
]
tour = {"active": False, "step": 0, "finished": False, "note": "", "hits": 0}


def _advance_if_done():
    """Complete the current step if it's a poll step whose check passes."""
    i = tour["step"]
    while i < len(TOUR) and TOUR[i][1] == "poll" and TOUR[i][2]():
        i += 1
        tour["hits"] = 0
    if i != tour["step"]:
        tour["step"] = i
        _maybe_finish()


def _maybe_finish():
    if tour["step"] >= len(TOUR):
        tour["active"] = False
        tour["finished"] = True
        tour["finished_at"] = time.time()
        st = load_learning()
        st["toured"] = True
        save_learning(st)


def tour_thread():
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    own = (own_window_address() or "").replace("0x", "")
    try:
        import socket as sk
        sigs = os.listdir(os.path.join(run, "hypr"))
        s2 = sk.socket(sk.AF_UNIX)
        s2.connect(os.path.join(run, "hypr", sigs[0], ".socket2.sock"))
        s2.settimeout(1.0)
        buf = b""
        deadline = time.time() + 900
        _advance_if_done()
        while tour["active"] and time.time() < deadline:
            try:
                chunk = s2.recv(4096)
            except OSError:
                _advance_if_done()
                continue
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                ev, _, d = line.decode(errors="replace").partition(">>")
                if own and ev in ("changefloatingmode", "closewindow") \
                        and own in d.replace("0x", "") \
                        and tour["step"] < len(TOUR) - 1:
                    tour["note"] = ("Careful \u2014 that one hit ME, not the "
                                    "terminal \U0001f605 Arrow your focus onto another window "
                                    "first, then try the key again. (If I ever "
                                    "look broken: SUPER+W on me, then "
                                    "SUPER+H brings me back fresh.)")
                    continue
                i = tour["step"]
                if i < len(TOUR) and TOUR[i][1] == "event" and TOUR[i][2](ev, d):
                    tour["hits"] = tour.get("hits", 0) + 1
                    if tour["hits"] >= TOUR[i][3]:
                        tour["step"] = i + 1
                        tour["hits"] = 0
                        _maybe_finish()
                    if not tour["active"]:
                        return
                _advance_if_done()
                if not tour["active"]:
                    return
        tour["active"] = False
    except Exception:
        tour["active"] = False


def load_learning():
    try:
        return json.load(open(LEARNING))
    except Exception:
        return {}


def save_learning(st):
    os.makedirs(DATA, exist_ok=True)
    json.dump(st, open(LEARNING, "w"))


def learning_status():
    st = load_learning()
    taught = st.get("taught", {})
    observed = st.get("observed", {})
    items = []
    for fid, label, q, obs in CURRICULUM:
        done = fid in taught or (obs and obs in observed)
        items.append({"id": fid, "label": label, "done": bool(done)})
    return st, items


def read_theme():
    """The active Omarchy theme's palette (colors.toml)."""
    try:
        import tomllib
        p = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
        with open(p, "rb") as f:
            return tomllib.load(f)
    except Exception:
        return {}



_facts = {"at": 0.0, "text": ""}


def machine_facts():
    """Live facts injected into every prompt so Archy never asks what it can
    know, and answers match THIS machine."""
    if time.time() - _facts["at"] < 600 and _facts["text"]:
        return _facts["text"]
    def run(cmd):
        try:
            return subprocess.run(cmd, capture_output=True, text=True,
                                  timeout=8).stdout.strip()
        except Exception:
            return ""
    mons = ""
    try:
        mons = "; ".join(
            f"{m['name']} {m['width']}x{m['height']}@{m['x']},{m['y']}"
            for m in json.loads(hypr("j/monitors") or "[]"))
    except Exception:
        pass
    facts = {
        "terminal": run(["xdg-terminal-exec", "--print-id"]) or "foot",
        "browser": run(["xdg-settings", "get", "default-web-browser"]),
        "agent": default_agent() or "none",
        "monitors": mons,
        "omarchy": run(["cat", os.path.expanduser("~/.local/share/omarchy/version")]),
    }
    _facts["text"] = "; ".join(f"{k}: {v}" for k, v in facts.items() if v)
    _facts["at"] = time.time()
    return _facts["text"]


lock = threading.Lock()
state = {"sid": None, "primed": ""}
history = []  # [(who, text)] session transcript, restored on widget reopen


def agent_ready():
    import shutil
    agent = default_agent()
    return agent in HEADLESS_AGENTS and bool(shutil.which(agent))


def default_agent():
    """Omarchy's chosen agent (~/.config/omarchy/defaults/agent), like the
    crash checker: the helper serves whichever agent the user picked."""
    try:
        return open(os.path.expanduser("~/.config/omarchy/defaults/agent")).read().strip()
    except OSError:
        return ""


HEADLESS_AGENTS = ("claude", "codex")  # agents we can call inline for the chat

# DO-IT-FOR-ME mode: user-consented (button click), deliberately scoped —
# file edits plus only the commands an Omarchy config change needs. No blanket
# shell access; Codex additionally stays inside $HOME via workspace sandbox.
TRUST_FILE = os.path.expanduser("~/.config/omarchy-help/trust")


def trust_level():
    """User-chosen power for DO-IT-FOR-ME: 'fixer' (default, scoped tools,
    fast model) or 'mechanic' (broad tools, strongest model). Set only via
    the widget's gear menu; per-click consent applies at every level."""
    try:
        t = open(TRUST_FILE).read().strip().lower()
        return t if t in ("fixer", "mechanic") else "fixer"
    except OSError:
        return "fixer"


ACT_ALLOWED = ",".join([
    "Read", "Grep", "Glob", "Edit", "Write",
    "Bash(hyprctl *)", "Bash(omarchy *)", "Bash(omarchy-* *)",
    "Bash(cp *)", "Bash(mkdir *)", "Bash(xdg-settings *)",
    "Bash(systemctl --user *)",
])
ACT_BRIEF = (
    "\n\n(The user clicked DO-IT-FOR-ME: they explicitly consent to you making "
    "this change on their machine now. Rules: touch ONLY user-level Omarchy "
    "config (~/.config/hypr/*.lua, ~/.config/omarchy/**, app settings under "
    "~/.config) — NEVER /usr/share/omarchy or system files. Back up every "
    "file you edit first (cp X X.bak-archy). Apply via the sanctioned "
    "override files and hyprctl reload / omarchy commands. VERIFY the change "
    "took effect. Then report chat-style: what changed, how you verified it, "
    "and the one-line undo. If part of the request is dangerous or unclear, "
    "do only the safe part and say what you skipped.)")
ACT_HINT = (
    "\n(If the allowed tools are too narrow for this request, do what you "
    "can and tell the user that Mechanic trust — Archy's gear menu — would "
    "let you do the rest.)")
# Mechanic: the user's own agent with its normal working powers, on the
# strongest model — chosen deliberately in the gear menu, consented per
# click. Same red lines as always: no sudo, no data deletion, backup first.
MECH_ALLOWED = ",".join(["Read", "Grep", "Glob", "Edit", "Write", "Bash"])
MECH_BRIEF = (
    "\n\n(The user clicked DO-IT-FOR-ME at MECHANIC trust: they explicitly "
    "consent to you making this change on their machine now, with broad "
    "powers. Rules: prefer user-level config and sanctioned omarchy/hyprctl "
    "flows; back up EVERY file you edit first (cp X X.bak-archy); never use "
    "sudo, never delete user data, never touch credentials or secrets. "
    "VERIFY the change took effect. Then report chat-style: what changed, "
    "how you verified it, and the one-line undo. If part of the request is "
    "dangerous or unclear, do only the safe part and say what you skipped.)")


def ask_act(q):
    """Consented action: the agent may edit user-level Omarchy config."""
    agent = default_agent() or "claude"
    level = trust_level()
    brief = MECH_BRIEF if level == "mechanic" else ACT_BRIEF + ACT_HINT
    prompt = q + brief + "\n(Machine facts: " + machine_facts() + ")"
    home = os.path.expanduser("~")
    if agent == "codex":
        out = subprocess.run(
            ["codex", "exec", "--sandbox", "workspace-write", prompt],
            cwd=home, capture_output=True, text=True, timeout=300)
        if out.returncode != 0:
            out = subprocess.run(["codex", "exec", prompt], cwd=home,
                                 capture_output=True, text=True, timeout=300)
        if out.returncode != 0:
            raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
        return out.stdout.strip()[-2500:] or "Done (no summary returned)."
    tools = MECH_ALLOWED if level == "mechanic" else ACT_ALLOWED
    # Fixer stays on a fast mid model; Mechanic runs on the user's default
    # (strongest) model — fixes are rare, they deserve the real brain.
    model = [] if level == "mechanic" else ["--model", "sonnet"]
    out = subprocess.run(["claude", "-p", prompt, "--output-format", "json",
                          *model, "--allowedTools=" + tools],
                         cwd=home, capture_output=True, text=True, timeout=300)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
    data = json.loads(out.stdout)
    return (data.get("result") or "").strip() or "Done (no summary returned)."


def ask_claude(q, resume):
    # NOTE: --allowedTools is variadic — keep the prompt ahead of it and use
    # the = form, or it swallows the prompt as a tool name.
    # A tutor needs speed, not deep reasoning: fast model on purpose.
    args = ["claude", "-p", q + STYLE.format(facts=machine_facts()), "--output-format", "json",
            "--model", "haiku", "--allowedTools=" + ALLOWED]
    if resume and state["sid"]:
        args += ["--resume", state["sid"]]
    out = subprocess.run(args, cwd=DIR, capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
    data = json.loads(out.stdout)
    state["sid"] = data.get("session_id") or state["sid"]
    return (data.get("result") or "").strip() or "Sorry — I came back empty. Try asking again."


def ask_codex(q):
    # Low reasoning effort for speed; retry plain if this codex predates it.
    fast = ["codex", "exec", "-c", "model_reasoning_effort=low", q + STYLE.format(facts=machine_facts())]
    out = subprocess.run(fast, cwd=DIR, capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        out = subprocess.run(["codex", "exec", q + STYLE.format(facts=machine_facts())], cwd=DIR,
                             capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
    return out.stdout.strip()[-2000:] or "Sorry — I came back empty."


def ask_agent(q, resume):
    agent = default_agent() or "claude"
    if agent == "codex":
        return ask_codex(q)
    return ask_claude(q, resume)


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            html = open(UI).read()
            t = read_theme()
            if t.get("background"):
                light = t.get("mode") == "light"
                css = ":root{" + "".join(
                    f"{k}:{v};" for k, v in {
                        "--bg": t.get("background"),
                        "--panel": (t.get("darker_background") if light else t.get("dark_background"))
                                   or t.get("dark_background") or t.get("background"),
                        "--line": t.get("muted") or t.get("selection") or "#555",
                        "--ink": t.get("foreground"),
                        "--muted": t.get("dark_foreground") or t.get("muted"),
                        "--ember": t.get("accent") or t.get("blue") or "#ffb454",
                        "--bot": t.get("lighter_background") or t.get("selection"),
                        "--me": t.get("selection") or t.get("lighter_background"),
                        "--on-accent": "#ffffff" if light else (t.get("darker_background") or "#111"),
                    }.items() if v) + "}"
                html = html.replace("/*__THEME__*/", css)
            if agent_ready():
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Archy \U0001F916 I\u2019ll teach you Omarchy "
                    "hands-on (\U0001f680 starts the live tour), answer anything "
                    "about *this* machine \u2014 and with the \U0001f527 under my "
                    "answers I can make the fixes for you. Ask away.")
                html = html.replace("__HINT__",
                    "your AI \u00b7 grounded in this machine \u00b7 \u2699 sets "
                    "what I may change")
            else:
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Archy \U0001F916 your Omarchy guide. No AI agent is "
                    "connected yet \u2014 tap a quick answer below to get going "
                    "(\u201cSet up your AI agent\u201d unlocks the full chat, and "
                    "then I can fix things for you, not just explain them).")
                html = html.replace("__HINT__",
                    "quick answers work offline \u00b7 connect an agent for everything else")
            self._send(200, html.encode(), "text/html")
        elif self.path.startswith("/vendor/"):
            name = os.path.basename(self.path)
            p = os.path.join(DIR, "vendor", name)
            if name.endswith(".js") and os.path.isfile(p):
                return self._send(200, open(p, "rb").read(), "application/javascript")
            return self._send(404, {"error": "not found"})
        elif self.path == "/health":
            self._send(200, {"ok": True})
        elif self.path == "/faq":
            # The starter chips are onboarding: shown only while no AI agent
            # is connected (Luke: with an agent they're clutter).
            entries = []
            for p in (os.path.join(DIR, "faq.json"), os.path.join(DATA, "faq.json")):
                if os.path.exists(p):
                    try:
                        entries = json.load(open(p))
                    except Exception:
                        pass
                    break
            return self._send(200, {"ready": agent_ready(), "faq": entries})
        elif self.path == "/prime":
            q = state.pop("primed", "")
            self._send(200, {"q": q})
        elif self.path == "/tour/state":
            note = tour.pop("note", "") if tour.get("note") else ""
            self._send(200, {"active": tour["active"], "step": tour["step"],
                             "finished": tour["finished"], "note": note,
                             "fresh_finish": time.time() - tour.get("finished_at", 0) < 120,
                             "steps": [t[0] for t in TOUR]})
        elif self.path == "/history":
            self._send(200, {"turns": history[-40:]})
        elif self.path == "/learn":
            _, items = learning_status()
            self._send(200, {"items": items,
                             "done": sum(1 for i in items if i["done"]),
                             "total": len(items),
                             "toured": load_learning().get("toured", False)})
        elif self.path == "/status":
            ensure_window_rule()   # widget is about to open/toggle
            self._send(200, {"window": bool(own_window_address())})
        elif self.path == "/trust":
            self._send(200, {"trust": trust_level()})
        elif self.path == "/theme":
            self._send(200, read_theme())
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if self.path == "/tour/start":
            tour.update({"active": True, "step": 0, "finished": False, "note": "", "hits": 0})
            threading.Thread(target=tour_thread, daemon=True).start()
            return self._send(200, {"ok": True, "steps": [t[0] for t in TOUR]})
        if self.path == "/tour/stop":
            tour["active"] = False
            return self._send(200, {"ok": True})
        if self.path == "/learn/next":
            st, items = learning_status()
            nxt = next((i for i in items if not i["done"]), None)
            if nxt is None:
                return self._send(200, {"q": "", "msg": "You've explored the whole path \U0001f393"})
            q = next(qq for fid, _, qq, _ in CURRICULUM if fid == nxt["id"])
            st.setdefault("taught", {})[nxt["id"]] = time.time()
            save_learning(st)
            return self._send(200, {"q": q, "label": nxt["label"]})
        if self.path == "/toured":
            st = load_learning()
            st["toured"] = True
            save_learning(st)
            return self._send(200, {"ok": True})
        if self.path == "/prime":
            # A teaching question queued by the tip watcher: the widget asks
            # it automatically the next time it becomes visible.
            n = int(self.headers.get("Content-Length", 0))
            try:
                state["primed"] = json.loads(self.rfile.read(n)).get("q", "")[:500]
            except Exception:
                return self._send(400, {"error": "bad request"})
            return self._send(200, {"ok": True})
        if self.path == "/trust":
            n = int(self.headers.get("Content-Length", 0))
            try:
                t = json.loads(self.rfile.read(n)).get("trust", "").strip().lower()
            except Exception:
                return self._send(400, {"error": "bad request"})
            if t not in ("fixer", "mechanic"):
                return self._send(400, {"error": "fixer or mechanic"})
            os.makedirs(os.path.dirname(TRUST_FILE), exist_ok=True)
            with open(TRUST_FILE, "w") as f:
                f.write(t + "\n")
            return self._send(200, {"trust": t})
        if self.path == "/open":
            # Click-to-open: file paths in Archy's answers are links. Only
            # launches the sanctioned editor flow on an existing file under
            # known roots -- never executes anything from the path itself.
            n = int(self.headers.get("Content-Length", 0))
            try:
                p = json.loads(self.rfile.read(n)).get("path", "")[:500]
            except Exception:
                return self._send(400, {"error": "bad request"})
            p = os.path.realpath(os.path.expanduser(p.replace("$HOME", "~")))
            home = os.path.expanduser("~")
            roots = (home + "/", "/etc/", "/usr/", "/opt/", "/var/", "/srv/", "/tmp/")
            if p.startswith(roots) and os.path.isfile(p):
                subprocess.Popen(["omarchy-launch-config-editor", p],
                                 start_new_session=True)
                return self._send(200, {"ok": True})
            subprocess.Popen(["omarchy-notification-send", "Archy",
                              "Can\u2019t open " + p +
                              " \u2014 it doesn\u2019t exist (yet?)"],
                             start_new_session=True)
            return self._send(200, {"ok": False})
        if self.path == "/show":
            # Pinned widget is always visible when open; just focus it.
            if own_window_address():
                subprocess.run(["omarchy-launch-or-focus",
                                "brave-127.0.0.1__-Default", "true"], timeout=10)
            return self._send(200, {"ok": True})
        if self.path == "/minimize":
            # Archy is a PINNED widget (visible on every workspace); hiding
            # means closing the window — the chat survives server-side and is
            # restored on reopen. Targeted close: focus it, close the active.
            addr = own_window_address()
            if addr:
                subprocess.run(["omarchy-launch-or-focus",
                                "brave-127.0.0.1__-Default", "true"], timeout=10)
                time.sleep(0.3)
                hypr("dispatch hl.dsp.window.close()")
            return self._send(200, {"ok": bool(addr)})
        if self.path != "/ask":
            return self._send(404, {"error": "not found"})
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n))
            q = body.get("q", "").strip()[:2000]
            force = body.get("force")
            ephemeral = bool(body.get("ephemeral"))
        except Exception:
            return self._send(400, {"error": "bad request"})
        if not q:
            return self._send(400, {"error": "empty"})

        agent = default_agent()
        have_ai = agent_ready()
        if not have_ai:
            hint = ("No AI agent is connected yet. Omarchy is AI-first: pick "
                    "your coding agent once with SUPER+SPACE \u2192 Setup \u2192 "
                    "Default agent (or: omarchy default agent claude), sign in "
                    "to it, and I\u2019ll answer anything. The Getting-started "
                    "buttons above work without one.")
            if agent and agent not in HEADLESS_AGENTS:
                hint = (f"Your default agent is \u2018{agent}\u2019, which I can\u2019t "
                        "chat through inline yet (Claude Code and Codex work). "
                        "Switch with: omarchy default agent claude \u2014 or use "
                        "SUPER+A for a full agent session.")
            return self._send(200, {"a": hint, "src": "manual"})

        if force == "act":
            plan = str(body.get("plan", ""))[:700]
            aq = q + ("\n(Your earlier advice was: " + plan + ")" if plan else "")
            with lock:
                try:
                    answer = ask_act(aq)
                except subprocess.TimeoutExpired:
                    answer = ("That change took too long — nothing may have "
                              "been applied; ask me to check.")
                except Exception as e:
                    answer = "I hit a snag acting on that: " + str(e)[-300:]
            if not ephemeral:
                history.append(("me", "\U0001f527 " + q))
                history.append(("bot", answer))
            return self._send(200, {"a": answer, "src": "act"})

        # Ground every AI question locally first: with the matching manual
        # excerpt and keybindings already in the prompt, the agent can usually
        # answer without spawning tool calls — the main latency saver.
        context = local_answer(q)
        prompt = q
        if context:
            prompt += ("\n\n(Local search context — answer directly from this "
                       "when it suffices, verify live only if it doesn't:\n"
                       + context[:1200] + ")")
        with lock:
            try:
                answer = ask_agent(prompt, resume=True)
            except subprocess.TimeoutExpired:
                answer = "That took too long — try a simpler question."
            except Exception:
                # A stale/broken session shouldn't kill the chat: retry fresh.
                state["sid"] = None
                try:
                    answer = ask_agent(prompt, resume=False)
                except Exception as e:
                    answer = "I hit a snag: " + str(e)[-300:]
        if not ephemeral:
            history.append(("me", q))
            history.append(("bot", answer))
        self._send(200, {"a": answer, "src": "ai"})


if __name__ == "__main__":
    try:
        ensure_window_rule()
    except Exception:
        pass
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.serve_forever()
