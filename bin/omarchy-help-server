#!/usr/bin/env python3
# omarchy:summary=Serve the Omarchy Helper chat widget (offline manual answers + agent relay)
# omarchy:hidden=true
"""Omarchy Helper micro-server: serves the chat widget UI and relays each
message to a headless Claude Code call (with read-only grounding tools).
Local only (127.0.0.1), stdlib only, no telemetry."""
import http.server
import json
import os
import subprocess
import threading
import time

PORT = int(os.environ.get("OMARCHY_HELP_PORT", "8642"))
DIR = os.path.expanduser(os.environ.get("OMARCHY_HELP_DIR", "~/.config/omarchy-help"))
# Mutable state (fetched manual, learned facts) lives OUTSIDE the config dir
# so dotfile-manager redeploys can never wipe it.
DATA = os.path.expanduser(os.environ.get("OMARCHY_HELP_DATA", "~/.local/share/omarchy-help"))
UI = os.path.join(DIR, "ui.html")
ALLOWED = ",".join([
    "Read", "Grep", "Glob",
    "Bash(omarchy menu keybindings --print)",
    "Bash(hyprctl binds)", "Bash(hyprctl clients)", "Bash(hyprctl workspaces)",
    "Bash(ls /usr/share/omarchy/bin)",
])
STYLE = ("\n\n(Answer for a chat bubble: plain text, no markdown headings, "
         "max ~90 words unless asked for more.)")


# ---------------------------------------------------------------- tier 1
# Offline answers: a tiny full-text index over the bundled manual, the
# knowledge file, and the machine's live keybindings. No LLM required.
import re as _re

_WORD = _re.compile(r"[a-zA-Z][a-zA-Z0-9+\-]{1,}")
_STOP = set("the a an and or of to in on for with how do i does what is are my "
            "you your it this that can where when omarchy use using used why "
            "work works working different way ways get set new want would "
            "should could there some more make makes".split())


def _tokens(text):
    out = []
    for w in _WORD.findall(text):
        w = w.lower()
        if w in _STOP:
            continue
        # cheap stemming so app/apps, theme/themes, keybinding/keybindings meet
        if len(w) > 3 and w.endswith("s") and not w.endswith("ss"):
            w = w[:-1]
        out.append(w)
    return out


def _sections():
    docs = []
    for base, tag in ((os.path.join(DATA, "manual"), "manual"),
                      (DIR, "notes"), (DATA, "notes")):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".md"):
                continue
            if tag == "notes" and name not in ("KNOWLEDGE.md", "LEARNED.md", "LOCAL.md"):  # noqa
                continue
            try:
                text = open(os.path.join(base, name)).read()
            except OSError:
                continue
            fname_words = " ".join(name[:-3].split("-"))
            for part in _re.split(r"\n(?=#{1,3} )", text):
                lines = part.strip().splitlines()
                if not lines:
                    continue
                head = (lines[0].lstrip("# ").strip() or name) + " " + fname_words
                body = "\n".join(lines[1:]).strip()
                if body:
                    docs.append((f"{head}", body, tag))
    return docs


def _keybinds():
    try:
        out = subprocess.run(["omarchy", "menu", "keybindings", "--print"],
                             capture_output=True, text=True, timeout=10)
        return out.stdout
    except Exception:
        return ""


_index = {"sig": None, "docs": []}


def _index_sig():
    sig = []
    for base in (os.path.join(DATA, "manual"), DIR, DATA):
        try:
            for n in os.listdir(base):
                if n.endswith(".md"):
                    sig.append((n, os.path.getmtime(os.path.join(base, n))))
        except OSError:
            pass
    return tuple(sorted(sig))


def get_index():
    sig = _index_sig()
    if sig != _index["sig"]:
        _index["docs"] = _sections()
        _index["sig"] = sig
    return _index["docs"]


def local_answer(q):
    """Best-matching manual/knowledge section for q, or None."""
    qt = _tokens(q)
    if not qt:
        return None
    qset = set(qt)
    best, score = None, 0.0
    for head, body, tag in get_index():
        ht, bt = _tokens(head), _tokens(body)
        if not bt:
            continue
        bset = set(bt)
        hmatch = len(qset & set(ht))
        s = 3.0 * hmatch                            # title/filename hits: undamped
        if hmatch and ht:
            s += 1.5 * hmatch / len(set(ht))        # focused titles beat long ones
        freq = sum(min(bt.count(w), 3) for w in qset)   # repeated terms matter
        s += freq / (1 + 0.02 * len(bt))
        if s > score:
            best, score = (head, body, tag), s
    # keybinding questions: grep the live bindings too
    kb_hit = ""
    if any(w in qset for w in ("key", "keys", "shortcut", "keybinding", "bind",
                               "super", "press", "hotkey")):
        kb = _keybinds()
        hits = [l for l in kb.splitlines()
                if any(w in l.lower() for w in qt)][:4]
        kb_hit = "\n".join(hits)
    if score < 3.8 and not kb_hit:
        return None
    parts = []
    if best:
        body = best[1]
        body = body if len(body) <= 700 else body[:700].rsplit(" ", 1)[0] + " …"
        parts.append(f"From the {'manual' if best[2] == 'manual' else 'notes'} — {best[0]}:\n{body}")
    if kb_hit:
        parts.append("Your live keybindings say:\n" + kb_hit)
    return "\n\n".join(parts)


LEARNING = os.path.join(DATA, "learning.json")

# The path from newcomer to advanced user, in teaching order. "observe" names
# the watcher-detectable signal that the user already uses the feature.
CURRICULUM = [
    ("menu", "The Omarchy menu", "How do I open the Omarchy menu and what can I do from it?", None),
    ("keys", "The keybinding overlay", "How do I see every keybinding on my machine?", None),
    ("workspaces", "Workspaces", "How do I use workspaces? Teach me the basics briefly.", "workspaces"),
    ("movewindows", "Moving windows", "How do I move and swap windows with the keyboard?", None),
    ("scratchpad", "The scratchpad", "What is the scratchpad and how do I use it?", "scratchpad"),
    ("webapps", "Websites as apps", "How do I turn a website into an app with its own window and icon?", "webapps"),
    ("install", "Installing software", "How do I install and remove apps, including from the AUR?", None),
    ("floating", "Floating windows", "How do I make a window float, move and resize it?", "floating"),
    ("fullscreen", "Full screen modes", "What are the fullscreen and maximize keys and when do I use each?", "fullscreen"),
    ("themes", "Themes", "How do I change the theme and background, and install new themes?", None),
    ("capture", "Screenshots and OCR", "How do I take screenshots and grab text from the screen?", None),
    ("update", "Staying updated", "How do I keep Omarchy updated and what happens during an update?", None),
    ("agents", "Your AI agent", "What can my default AI agent do across Omarchy, like diagnosing crashes?", None),
    ("config", "Customizing safely", "How do I customize Omarchy safely so updates never break my changes?", None),
]


# ---- the LIVE tour: Archie instructs, the event socket confirms ----------
# Steps chosen so every action is verifiable from socket2 AND safe while the
# widget overlay is visible (no other special workspace involved).
TOUR = [
    ("Open a terminal: press SUPER+RETURN.",
     lambda ev, d: ev == "openwindow" and ",foot," in "," + d.lower() + ","),
    ("Nice. Now switch to workspace 2: SUPER+2.",
     lambda ev, d: ev == "workspace" and d.strip().split(",")[-1] == "2"),
    ("See how it's a fresh desk? Come back with SUPER+1.",
     lambda ev, d: ev == "workspace" and d.strip().split(",")[-1] == "1"),
    ("Make the focused window float free: SUPER+T.",
     lambda ev, d: ev == "changefloatingmode"),
    ("Now close it the Omarchy way: SUPER+W.",
     lambda ev, d: ev == "closewindow"),
]
tour = {"active": False, "step": 0, "finished": False}


def tour_thread():
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        import socket as sk
        sigs = os.listdir(os.path.join(run, "hypr"))
        s2 = sk.socket(sk.AF_UNIX)
        s2.connect(os.path.join(run, "hypr", sigs[0], ".socket2.sock"))
        s2.settimeout(1.0)
        buf = b""
        deadline = time.time() + 600
        while tour["active"] and time.time() < deadline:
            try:
                chunk = s2.recv(4096)
            except OSError:
                continue
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                ev, _, d = line.decode(errors="replace").partition(">>")
                i = tour["step"]
                if i < len(TOUR) and TOUR[i][1](ev, d):
                    tour["step"] = i + 1
                    if tour["step"] >= len(TOUR):
                        tour["active"] = False
                        tour["finished"] = True
                        st = load_learning()
                        st["toured"] = True
                        save_learning(st)
                        return
        tour["active"] = False
    except Exception:
        tour["active"] = False


def load_learning():
    try:
        return json.load(open(LEARNING))
    except Exception:
        return {}


def save_learning(st):
    os.makedirs(DATA, exist_ok=True)
    json.dump(st, open(LEARNING, "w"))


def learning_status():
    st = load_learning()
    taught = st.get("taught", {})
    observed = st.get("observed", {})
    items = []
    for fid, label, q, obs in CURRICULUM:
        done = fid in taught or (obs and obs in observed)
        items.append({"id": fid, "label": label, "done": bool(done)})
    return st, items


def read_theme():
    """The active Omarchy theme's palette (colors.toml)."""
    try:
        import tomllib
        p = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
        with open(p, "rb") as f:
            return tomllib.load(f)
    except Exception:
        return {}


def hypr(cmd):
    """Send one command to the Hyprland socket (works even when the server
    was started outside the session env)."""
    import socket as sk
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        sigs = os.listdir(os.path.join(run, "hypr"))
        sig = sigs[0] if sigs else None
    if not sig:
        return ""
    s = sk.socket(sk.AF_UNIX)
    s.connect(os.path.join(run, "hypr", sig, ".socket.sock"))
    s.send(cmd.encode())
    out = s.recv(8192).decode()
    s.close()
    return out


def own_window_address():
    data = json.loads(hypr("j/clients") or "[]")
    for c in data:
        if "127.0.0.1" in c.get("class", ""):
            return c.get("address")
    return None
lock = threading.Lock()
state = {"sid": None, "primed": ""}


def agent_ready():
    import shutil
    agent = default_agent()
    return agent in HEADLESS_AGENTS and bool(shutil.which(agent))


def default_agent():
    """Omarchy's chosen agent (~/.config/omarchy/defaults/agent), like the
    crash checker: the helper serves whichever agent the user picked."""
    try:
        return open(os.path.expanduser("~/.config/omarchy/defaults/agent")).read().strip()
    except OSError:
        return ""


HEADLESS_AGENTS = ("claude", "codex")  # agents we can call inline for the chat


def ask_claude(q, resume):
    # NOTE: --allowedTools is variadic — keep the prompt ahead of it and use
    # the = form, or it swallows the prompt as a tool name.
    # A tutor needs speed, not deep reasoning: fast model on purpose.
    args = ["claude", "-p", q + STYLE, "--output-format", "json",
            "--model", "haiku", "--allowedTools=" + ALLOWED]
    if resume and state["sid"]:
        args += ["--resume", state["sid"]]
    out = subprocess.run(args, cwd=DIR, capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
    data = json.loads(out.stdout)
    state["sid"] = data.get("session_id") or state["sid"]
    return (data.get("result") or "").strip() or "Sorry — I came back empty. Try asking again."


def ask_codex(q):
    # Low reasoning effort for speed; retry plain if this codex predates it.
    fast = ["codex", "exec", "-c", "model_reasoning_effort=low", q + STYLE]
    out = subprocess.run(fast, cwd=DIR, capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        out = subprocess.run(["codex", "exec", q + STYLE], cwd=DIR,
                             capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
    return out.stdout.strip()[-2000:] or "Sorry — I came back empty."


def ask_agent(q, resume):
    agent = default_agent() or "claude"
    if agent == "codex":
        return ask_codex(q)
    return ask_claude(q, resume)


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            html = open(UI).read()
            t = read_theme()
            if t.get("background"):
                light = t.get("mode") == "light"
                css = ":root{" + "".join(
                    f"{k}:{v};" for k, v in {
                        "--bg": t.get("background"),
                        "--panel": (t.get("darker_background") if light else t.get("dark_background"))
                                   or t.get("dark_background") or t.get("background"),
                        "--line": t.get("muted") or t.get("selection") or "#555",
                        "--ink": t.get("foreground"),
                        "--muted": t.get("dark_foreground") or t.get("muted"),
                        "--ember": t.get("accent") or t.get("blue") or "#ffb454",
                        "--bot": t.get("lighter_background") or t.get("selection"),
                        "--me": t.get("selection") or t.get("lighter_background"),
                        "--on-accent": "#ffffff" if light else (t.get("darker_background") or "#111"),
                    }.items() if v) + "}"
                html = html.replace("/*__THEME__*/", css)
            if agent_ready():
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Archie \U0001F916 your Omarchy guide. Ask me anything \u2014 "
                    "or hit \U0001f680 for the live tour and I\u2019ll teach you the "
                    "moves hands-on.")
                html = html.replace("__HINT__",
                    "answers come from your AI, grounded in this machine")
            else:
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Archie \U0001F916 your Omarchy guide. No AI agent is "
                    "connected yet \u2014 tap a quick answer below to get going "
                    "(\u201cSet up your AI agent\u201d unlocks the full chat).")
                html = html.replace("__HINT__",
                    "quick answers work offline \u00b7 connect an agent for everything else")
            self._send(200, html.encode(), "text/html")
        elif self.path == "/health":
            self._send(200, {"ok": True})
        elif self.path == "/faq":
            # The starter chips are onboarding: shown only while no AI agent
            # is connected (Luke: with an agent they're clutter).
            entries = []
            for p in (os.path.join(DIR, "faq.json"), os.path.join(DATA, "faq.json")):
                if os.path.exists(p):
                    try:
                        entries = json.load(open(p))
                    except Exception:
                        pass
                    break
            return self._send(200, {"ready": agent_ready(), "faq": entries})
        elif self.path == "/prime":
            q = state.pop("primed", "")
            self._send(200, {"q": q})
        elif self.path == "/tour/state":
            self._send(200, {"active": tour["active"], "step": tour["step"],
                             "finished": tour["finished"]})
        elif self.path == "/learn":
            _, items = learning_status()
            self._send(200, {"items": items,
                             "done": sum(1 for i in items if i["done"]),
                             "total": len(items),
                             "toured": load_learning().get("toured", False)})
        elif self.path == "/status":
            self._send(200, {"window": bool(own_window_address())})
        elif self.path == "/theme":
            self._send(200, read_theme())
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if self.path == "/tour/start":
            tour.update({"active": True, "step": 0, "finished": False})
            threading.Thread(target=tour_thread, daemon=True).start()
            return self._send(200, {"ok": True, "steps": [t[0] for t in TOUR]})
        if self.path == "/tour/stop":
            tour["active"] = False
            return self._send(200, {"ok": True})
        if self.path == "/learn/next":
            st, items = learning_status()
            nxt = next((i for i in items if not i["done"]), None)
            if nxt is None:
                return self._send(200, {"q": "", "msg": "You've explored the whole path \U0001f393"})
            q = next(qq for fid, _, qq, _ in CURRICULUM if fid == nxt["id"])
            st.setdefault("taught", {})[nxt["id"]] = time.time()
            save_learning(st)
            return self._send(200, {"q": q, "label": nxt["label"]})
        if self.path == "/toured":
            st = load_learning()
            st["toured"] = True
            save_learning(st)
            return self._send(200, {"ok": True})
        if self.path == "/prime":
            # A teaching question queued by the tip watcher: the widget asks
            # it automatically the next time it becomes visible.
            n = int(self.headers.get("Content-Length", 0))
            try:
                state["primed"] = json.loads(self.rfile.read(n)).get("q", "")[:500]
            except Exception:
                return self._send(400, {"error": "bad request"})
            return self._send(200, {"ok": True})
        if self.path == "/show":
            # Idempotent reveal: toggle the overlay ON only if it's hidden.
            # (A blind toggle raced the window-rule's auto-show: first open
            # revealed then immediately re-hid the widget.)
            mons = json.loads(hypr("j/monitors") or "[]")
            visible = any(m.get("specialWorkspace", {}).get("name") == "special:helper"
                          for m in mons)
            if not visible:
                hypr('dispatch hl.dsp.workspace.toggle_special("helper")')
            return self._send(200, {"ok": True, "was_visible": visible})
        if self.path == "/minimize":
            # The widget lives on special:helper (window rule); hiding is just
            # flipping that overlay off. v4's lua IPC syntax, learned the hard
            # way: dispatch hl.dsp.workspace.toggle_special("helper").
            hypr('dispatch hl.dsp.workspace.toggle_special("helper")')
            return self._send(200, {"ok": True})
        if self.path != "/ask":
            return self._send(404, {"error": "not found"})
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n))
            q = body.get("q", "").strip()[:2000]
            force = body.get("force")
        except Exception:
            return self._send(400, {"error": "bad request"})
        if not q:
            return self._send(400, {"error": "empty"})

        agent = default_agent()
        have_ai = agent_ready()
        if not have_ai:
            hint = ("No AI agent is connected yet. Omarchy is AI-first: pick "
                    "your coding agent once with SUPER+SPACE \u2192 Setup \u2192 "
                    "Default agent (or: omarchy default agent claude), sign in "
                    "to it, and I\u2019ll answer anything. The Getting-started "
                    "buttons above work without one.")
            if agent and agent not in HEADLESS_AGENTS:
                hint = (f"Your default agent is \u2018{agent}\u2019, which I can\u2019t "
                        "chat through inline yet (Claude Code and Codex work). "
                        "Switch with: omarchy default agent claude \u2014 or use "
                        "SUPER+A for a full agent session.")
            return self._send(200, {"a": hint, "src": "manual"})

        # Ground every AI question locally first: with the matching manual
        # excerpt and keybindings already in the prompt, the agent can usually
        # answer without spawning tool calls — the main latency saver.
        context = local_answer(q)
        prompt = q
        if context:
            prompt += ("\n\n(Local search context — answer directly from this "
                       "when it suffices, verify live only if it doesn't:\n"
                       + context[:1200] + ")")
        with lock:
            try:
                answer = ask_agent(prompt, resume=True)
            except subprocess.TimeoutExpired:
                answer = "That took too long — try a simpler question."
            except Exception:
                # A stale/broken session shouldn't kill the chat: retry fresh.
                state["sid"] = None
                try:
                    answer = ask_agent(prompt, resume=False)
                except Exception as e:
                    answer = "I hit a snag: " + str(e)[-300:]
        self._send(200, {"a": answer, "src": "ai"})


if __name__ == "__main__":
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.serve_forever()
