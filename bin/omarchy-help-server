#!/usr/bin/env python3
# omarchy:summary=Serve the Omarchy Helper chat widget (offline manual answers + agent relay)
# omarchy:hidden=true
"""Omarchy Helper micro-server: serves the chat widget UI and relays each
message to a headless Claude Code call (with read-only grounding tools).
Local only (127.0.0.1), stdlib only, no telemetry."""
import http.server
import json
import os
import subprocess
import threading
import time

PORT = int(os.environ.get("OMARCHY_HELP_PORT", "8642"))
DIR = os.path.expanduser(os.environ.get("OMARCHY_HELP_DIR", "~/.config/omarchy-help"))
# Mutable state (fetched manual, learned facts) lives OUTSIDE the config dir
# so dotfile-manager redeploys can never wipe it.
DATA = os.path.expanduser(os.environ.get("OMARCHY_HELP_DATA", "~/.local/share/omarchy-help"))
UI = os.path.join(DIR, "ui.html")
ALLOWED = ",".join([
    "Read", "Grep", "Glob",
    "Bash(omarchy menu keybindings --print)",
    "Bash(hyprctl binds)", "Bash(hyprctl clients)", "Bash(hyprctl workspaces)",
    "Bash(ls /usr/share/omarchy/bin)",
])
STYLE = ("\n\n(Answer for a chat bubble. Structure it: one short lead line, "
         "then 2-4 bullet lines starting with '- ' for steps or options. Bold "
         "key names like **SUPER+K**. No headings, no long paragraphs, max "
         "~80 words unless asked for more. OMARCHY-FIRST, always: copy/paste "
         "is **SUPER+C/V/X** (never Ctrl+C/V here, even in the terminal), "
         "prefer omarchy menu flows and omarchy commands over generic Linux "
         "answers. NEVER ask the user about their setup \u2014 the machine "
         "facts below answer that.)"
         "\n(Machine facts \u2014 trust these: {facts})")


def hypr(cmd):
    """Send one command to the Hyprland socket (works even when the server
    was started outside the session env)."""
    import socket as sk
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        sigs = os.listdir(os.path.join(run, "hypr"))
        sig = sigs[0] if sigs else None
    if not sig:
        return ""
    s = sk.socket(sk.AF_UNIX)
    s.connect(os.path.join(run, "hypr", sig, ".socket.sock"))
    s.send(cmd.encode())
    out = s.recv(8192).decode()
    s.close()
    return out


_rule = {"at": 0.0}


def ensure_window_rule():
    """Float/pin the widget bottom-right for ANY chromium-family browser
    (class = <browser>-127.0.0.1__...). Injected at runtime via the shell's
    eval channel: no user config files touched, reapplied cheaply since a
    Hyprland reload clears runtime rules. Throttled to avoid stacking."""
    if time.time() - _rule["at"] < 600:
        return
    _rule["at"] = time.time()
    hypr('eval hl.window_rule({ match = { class = "^.*-127\\.0\\.0\\.1__.*$" }, '
         'float = true, pin = true, size = { 360, 480 }, '
         'move = { "(monitor_w-368)", "(monitor_h-488)" } })')


def own_window_address():
    data = json.loads(hypr("j/clients") or "[]")
    for c in data:
        if "127.0.0.1" in c.get("class", ""):
            return c.get("address")
    return None
_facts = {"at": 0.0, "text": ""}


def machine_facts():
    """Live facts injected into every prompt so Archy never asks what it can
    know, and answers match THIS machine."""
    if time.time() - _facts["at"] < 600 and _facts["text"]:
        return _facts["text"]
    def run(cmd):
        try:
            return subprocess.run(cmd, capture_output=True, text=True,
                                  timeout=8).stdout.strip()
        except Exception:
            return ""
    mons = ""
    try:
        mons = "; ".join(
            f"{m['name']} {m['width']}x{m['height']}@{m['x']},{m['y']}"
            for m in json.loads(hypr("j/monitors") or "[]"))
    except Exception:
        pass
    facts = {
        "terminal": run(["xdg-terminal-exec", "--print-id"]) or "foot",
        "browser": run(["xdg-settings", "get", "default-web-browser"]),
        "agent": default_agent() or "none",
        "monitors": mons,
        "omarchy": run(["cat", os.path.expanduser("~/.local/share/omarchy/version")]),
    }
    _facts["text"] = "; ".join(f"{k}: {v}" for k, v in facts.items() if v)
    _facts["at"] = time.time()
    return _facts["text"]


lock = threading.Lock()
state = {"sid": None, "primed": ""}
history = []  # [(who, text)] session transcript, restored on widget reopen


def agent_ready():
    import shutil
    agent = default_agent()
    return agent in HEADLESS_AGENTS and bool(shutil.which(agent))


def default_agent():
    """Omarchy's chosen agent (~/.config/omarchy/defaults/agent), like the
    crash checker: the helper serves whichever agent the user picked."""
    try:
        return open(os.path.expanduser("~/.config/omarchy/defaults/agent")).read().strip()
    except OSError:
        return ""


HEADLESS_AGENTS = ("claude", "codex")  # agents we can call inline for the chat


def ask_claude(q, resume):
    # NOTE: --allowedTools is variadic — keep the prompt ahead of it and use
    # the = form, or it swallows the prompt as a tool name.
    # A tutor needs speed, not deep reasoning: fast model on purpose.
    args = ["claude", "-p", q + STYLE.format(facts=machine_facts()), "--output-format", "json",
            "--model", "haiku", "--allowedTools=" + ALLOWED]
    if resume and state["sid"]:
        args += ["--resume", state["sid"]]
    out = subprocess.run(args, cwd=DIR, capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
    data = json.loads(out.stdout)
    state["sid"] = data.get("session_id") or state["sid"]
    return (data.get("result") or "").strip() or "Sorry — I came back empty. Try asking again."


def ask_codex(q):
    # Low reasoning effort for speed; retry plain if this codex predates it.
    fast = ["codex", "exec", "-c", "model_reasoning_effort=low", q + STYLE.format(facts=machine_facts())]
    out = subprocess.run(fast, cwd=DIR, capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        out = subprocess.run(["codex", "exec", q + STYLE.format(facts=machine_facts())], cwd=DIR,
                             capture_output=True, text=True, timeout=240)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "unknown error")
    return out.stdout.strip()[-2000:] or "Sorry — I came back empty."


def ask_agent(q, resume):
    agent = default_agent() or "claude"
    if agent == "codex":
        return ask_codex(q)
    return ask_claude(q, resume)


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            html = open(UI).read()
            t = read_theme()
            if t.get("background"):
                light = t.get("mode") == "light"
                css = ":root{" + "".join(
                    f"{k}:{v};" for k, v in {
                        "--bg": t.get("background"),
                        "--panel": (t.get("darker_background") if light else t.get("dark_background"))
                                   or t.get("dark_background") or t.get("background"),
                        "--line": t.get("muted") or t.get("selection") or "#555",
                        "--ink": t.get("foreground"),
                        "--muted": t.get("dark_foreground") or t.get("muted"),
                        "--ember": t.get("accent") or t.get("blue") or "#ffb454",
                        "--bot": t.get("lighter_background") or t.get("selection"),
                        "--me": t.get("selection") or t.get("lighter_background"),
                        "--on-accent": "#ffffff" if light else (t.get("darker_background") or "#111"),
                    }.items() if v) + "}"
                html = html.replace("/*__THEME__*/", css)
            if agent_ready():
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Archy \U0001F916 your Omarchy guide. Ask me anything \u2014 "
                    "or hit \U0001f680 for the live tour and I\u2019ll teach you the "
                    "moves hands-on.")
                html = html.replace("__HINT__",
                    "answers come from your AI, grounded in this machine")
            else:
                html = html.replace("__GREETING__",
                    "Hey, I\u2019m Archy \U0001F916 your Omarchy guide. No AI agent is "
                    "connected yet \u2014 tap a quick answer below to get going "
                    "(\u201cSet up your AI agent\u201d unlocks the full chat).")
                html = html.replace("__HINT__",
                    "quick answers work offline \u00b7 connect an agent for everything else")
            self._send(200, html.encode(), "text/html")
        elif self.path == "/health":
            self._send(200, {"ok": True})
        elif self.path == "/faq":
            # The starter chips are onboarding: shown only while no AI agent
            # is connected (Luke: with an agent they're clutter).
            entries = []
            for p in (os.path.join(DIR, "faq.json"), os.path.join(DATA, "faq.json")):
                if os.path.exists(p):
                    try:
                        entries = json.load(open(p))
                    except Exception:
                        pass
                    break
            return self._send(200, {"ready": agent_ready(), "faq": entries})
        elif self.path == "/prime":
            q = state.pop("primed", "")
            self._send(200, {"q": q})
        elif self.path == "/tour/state":
            note = tour.pop("note", "") if tour.get("note") else ""
            self._send(200, {"active": tour["active"], "step": tour["step"],
                             "finished": tour["finished"], "note": note,
                             "fresh_finish": time.time() - tour.get("finished_at", 0) < 120,
                             "steps": [t[0] for t in TOUR]})
        elif self.path == "/history":
            self._send(200, {"turns": history[-40:]})
        elif self.path == "/learn":
            _, items = learning_status()
            self._send(200, {"items": items,
                             "done": sum(1 for i in items if i["done"]),
                             "total": len(items),
                             "toured": load_learning().get("toured", False)})
        elif self.path == "/status":
            ensure_window_rule()   # widget is about to open/toggle
            self._send(200, {"window": bool(own_window_address())})
        elif self.path == "/theme":
            self._send(200, read_theme())
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if self.path == "/tour/start":
            tour.update({"active": True, "step": 0, "finished": False, "note": "", "hits": 0})
            threading.Thread(target=tour_thread, daemon=True).start()
            return self._send(200, {"ok": True, "steps": [t[0] for t in TOUR]})
        if self.path == "/tour/stop":
            tour["active"] = False
            return self._send(200, {"ok": True})
        if self.path == "/learn/next":
            st, items = learning_status()
            nxt = next((i for i in items if not i["done"]), None)
            if nxt is None:
                return self._send(200, {"q": "", "msg": "You've explored the whole path \U0001f393"})
            q = next(qq for fid, _, qq, _ in CURRICULUM if fid == nxt["id"])
            st.setdefault("taught", {})[nxt["id"]] = time.time()
            save_learning(st)
            return self._send(200, {"q": q, "label": nxt["label"]})
        if self.path == "/toured":
            st = load_learning()
            st["toured"] = True
            save_learning(st)
            return self._send(200, {"ok": True})
        if self.path == "/prime":
            # A teaching question queued by the tip watcher: the widget asks
            # it automatically the next time it becomes visible.
            n = int(self.headers.get("Content-Length", 0))
            try:
                state["primed"] = json.loads(self.rfile.read(n)).get("q", "")[:500]
            except Exception:
                return self._send(400, {"error": "bad request"})
            return self._send(200, {"ok": True})
        if self.path == "/show":
            # Pinned widget is always visible when open; just focus it.
            if own_window_address():
                subprocess.run(["omarchy-launch-or-focus",
                                "brave-127.0.0.1__-Default", "true"], timeout=10)
            return self._send(200, {"ok": True})
        if self.path == "/minimize":
            # Archy is a PINNED widget (visible on every workspace); hiding
            # means closing the window — the chat survives server-side and is
            # restored on reopen. Targeted close: focus it, close the active.
            addr = own_window_address()
            if addr:
                subprocess.run(["omarchy-launch-or-focus",
                                "brave-127.0.0.1__-Default", "true"], timeout=10)
                time.sleep(0.3)
                hypr("dispatch hl.dsp.window.close()")
            return self._send(200, {"ok": bool(addr)})
        if self.path != "/ask":
            return self._send(404, {"error": "not found"})
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n))
            q = body.get("q", "").strip()[:2000]
            force = body.get("force")
            ephemeral = bool(body.get("ephemeral"))
        except Exception:
            return self._send(400, {"error": "bad request"})
        if not q:
            return self._send(400, {"error": "empty"})

        agent = default_agent()
        have_ai = agent_ready()
        if not have_ai:
            hint = ("No AI agent is connected yet. Omarchy is AI-first: pick "
                    "your coding agent once with SUPER+SPACE \u2192 Setup \u2192 "
                    "Default agent (or: omarchy default agent claude), sign in "
                    "to it, and I\u2019ll answer anything. The Getting-started "
                    "buttons above work without one.")
            if agent and agent not in HEADLESS_AGENTS:
                hint = (f"Your default agent is \u2018{agent}\u2019, which I can\u2019t "
                        "chat through inline yet (Claude Code and Codex work). "
                        "Switch with: omarchy default agent claude \u2014 or use "
                        "SUPER+A for a full agent session.")
            return self._send(200, {"a": hint, "src": "manual"})

        # Ground every AI question locally first: with the matching manual
        # excerpt and keybindings already in the prompt, the agent can usually
        # answer without spawning tool calls — the main latency saver.
        context = local_answer(q)
        prompt = q
        if context:
            prompt += ("\n\n(Local search context — answer directly from this "
                       "when it suffices, verify live only if it doesn't:\n"
                       + context[:1200] + ")")
        with lock:
            try:
                answer = ask_agent(prompt, resume=True)
            except subprocess.TimeoutExpired:
                answer = "That took too long — try a simpler question."
            except Exception:
                # A stale/broken session shouldn't kill the chat: retry fresh.
                state["sid"] = None
                try:
                    answer = ask_agent(prompt, resume=False)
                except Exception as e:
                    answer = "I hit a snag: " + str(e)[-300:]
        if not ephemeral:
            history.append(("me", q))
            history.append(("bot", answer))
        self._send(200, {"a": answer, "src": "ai"})


if __name__ == "__main__":
    try:
        ensure_window_rule()
    except Exception:
        pass
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.serve_forever()
