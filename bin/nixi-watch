#!/usr/bin/env python3
# omarchy:summary=Watch desktop patterns and suggest one workflow tip a day at most
# omarchy:hidden=true
"""Workflow tip watcher — the crash-watcher pattern, pointed at habits.

Reads Hyprland's event socket, counts a few teachable patterns locally
(nothing leaves the machine), and when one crosses its threshold sends ONE
notification. Guardrails: at most one tip per day, each tip at most once per
14 days, and `systemctl --user disable --now nixi-watch` turns it off
for good. State: ~/.local/share/nixi/tips.json
"""
import json
import os
import socket
import stat
import subprocess
import time

DATA = os.path.expanduser(os.environ.get("NIXI_DATA", "~/.local/share/nixi"))
STATE = os.path.join(DATA, "tips.json")

# The descriptor-bound safe-IO floor, shared with install.py and
# nixi-update-manual (#60). It is installed into the same directory as this
# program by both install paths, and a script's own directory is sys.path[0].
from nixi_safeio import _UID, _dirfd, _write  # noqa: E402  (after the docstring block)

# Thresholds.
FLIPFLOP = 40
TERM_CHURN = 10
MONO_WINDOWS = 8
DAY_GAP = 24 * 3600
TIP_GAP = 14 * 24 * 3600

TERMINALS = {"foot", "alacritty", "kitty", "com.mitchellh.ghostty", "ghostty"}

TIPS = {
    # Voice: "I noticed <evidence> — <feature> could help." Observation first
    # (with the real number), offer second, lesson on click. Never preachy.
    "workspaces": ("I noticed everything lives on one workspace",
                   "{n} windows opened today without ever switching desks \u2014 "
                   "workspaces could untangle that in seconds. Click and I\u2019ll "
                   "show you how they work.",
                   "How do I use workspaces? Teach me the basics briefly."),
    "scratchpad": ("I noticed you keep opening new terminals",
                   "{n} today \u2014 there\u2019s a hidden one that drops over "
                   "anything with a single key and never closes. Click and "
                   "I\u2019ll show you.",
                   "What is the scratchpad and how do I use it? Teach me briefly."),
    "sidebyside": ("I noticed you bouncing between the same two windows",
                   "{n} switches and counting \u2014 side by side with the focus "
                   "keys would feel much smoother. Click and I\u2019ll show you.",
                   "How do I arrange two windows side by side and move focus "
                   "between them? Teach me briefly."),
}


def secure_read(name, cap):
    dfd = _dirfd(DATA)
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    finally:
        os.close(dfd)
    try:
        st = os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != _UID
                or (st.st_mode & 0o077) or st.st_size > cap):
            raise ValueError("bad state file")
        out = bytearray()
        while len(out) <= cap:
            b = os.read(fd, 65536)
            if not b:
                break
            out.extend(b)
        if len(out) > cap:
            raise ValueError("state file too large")
        return bytes(out)
    finally:
        os.close(fd)


def secure_write(name, data):
    """Replace the state file atomically, 0600, under a validated DATA fd."""
    dfd = _dirfd(DATA, create=True)
    try:
        _write(dfd, name, data, 0o600)
    finally:
        os.close(dfd)


def load_state():
    try:
        st = json.loads(secure_read("tips.json", 65536))
        return st if isinstance(st, dict) and len(st) <= 64 else {}
    except Exception:
        return {}


def save_state(st):
    try:
        secure_write("tips.json", json.dumps(st).encode())
    except Exception:
        pass


def run_quiet(cmd, timeout):
    """Supervised helper launch: own group, no pipes, killed on deadline."""
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    try:
        p.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        if p.poll() is None:          # leader still alive => PGID identity valid
            try:
                os.killpg(p.pid, 9)
            except OSError:
                pass
        p.wait()


def fire(tip_id, **fmt):
    st = load_state()
    now = time.time()
    if now - st.get("last_any", 0) < DAY_GAP:
        return False
    if now - st.get("last_" + tip_id, 0) < TIP_GAP:
        return False
    title, body, question = TIPS[tip_id]
    title = title.format(**fmt)
    body = body.format(**fmt)
    try:
        run_quiet(["omarchy-notification-wait"], timeout=30)
        run_quiet(["omarchy-notification-send", "--glyph", "\U0001f4a1",
                   title, body, "--exec", "nixi", "--ask", question],
                  timeout=15)
    except FileNotFoundError:
        print(f"TIP[{tip_id}]: {title} — {body}")  # test mode / no notifier
    st["last_any"] = now
    st["last_" + tip_id] = now
    save_state(st)
    return True


class Day:
    def __init__(self):
        self.reset()

    def reset(self):
        self.start = time.time()
        self.used_special = False
        self.workspaces = set()
        self.opens_by_class = {}
        self.total_opens = 0
        self.last_focus = None
        self.prev_focus = None
        self.flips = {}

    def maybe_roll(self):
        if time.time() - self.start > 24 * 3600:
            self.reset()

    def on_event(self, line):
        self.maybe_roll()
        if ">>" not in line:
            return
        ev, _, data = line.partition(">>")
        if ev == "workspace":
            name = data.strip()
            self.workspaces.add(name)
            if name.startswith("special"):
                self.used_special = True
        elif ev in ("activespecial", "activespecialv2"):
            if data.strip(","):
                self.used_special = True
        elif ev == "openwindow":
            # The screensaver is not a window the user opened.
            if "org.omarchy.screensaver" in data:
                return
            parts = data.split(",", 3)
            if len(parts) >= 3:
                cls = parts[2].strip().lower()
                self.workspaces.add(parts[1].strip())
                self.opens_by_class[cls] = self.opens_by_class.get(cls, 0) + 1
                self.total_opens += 1
                if (cls in TERMINALS
                        and self.opens_by_class[cls] >= TERM_CHURN
                        and not self.used_special
                        and fire("scratchpad", n=self.opens_by_class[cls])):
                    self.opens_by_class[cls] = 0
                if (self.total_opens >= MONO_WINDOWS
                        and len(self.workspaces) <= 1
                        and fire("workspaces", n=self.total_opens)):
                    self.total_opens = 0
        elif ev == "activewindow":
            cls = data.split(",", 1)[0].strip().lower()
            if not cls or cls == self.last_focus:
                return
            if self.prev_focus == cls and self.last_focus:
                pair = tuple(sorted((cls, self.last_focus)))
                self.flips[pair] = self.flips.get(pair, 0) + 1
                if self.flips[pair] >= FLIPFLOP and fire("sidebyside", n=self.flips[pair]):
                    self.flips[pair] = 0
            self.prev_focus, self.last_focus = self.last_focus, cls


def main():
    day = Day()
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    while True:
        try:
            sigs = os.listdir(os.path.join(run, "hypr"))
            if not sigs:
                time.sleep(10)
                continue
            s = socket.socket(socket.AF_UNIX)
            s.connect(os.path.join(run, "hypr", sigs[0], ".socket2.sock"))
            buf = b""
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
                if len(buf) > 1_000_000:
                    buf = b""
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    day.on_event(line.decode(errors="replace"))
        except OSError:
            pass
        time.sleep(5)  # compositor restarted; reconnect


if __name__ == "__main__":
    main()
