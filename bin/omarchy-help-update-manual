#!/usr/bin/env python3
# omarchy:summary=Refresh the Omarchy Helper's local copy of the official manual
"""Fetch the official Omarchy manual into the helper's private state dir so
answers can cite the real manual offline.

Integrity: everything is fetched at ONE pinned commit — the default branch
head SHA is resolved first, the manual tree is listed at that exact commit,
ONE tarball is downloaded at that immutable SHA, and every page is verified
against its git blob hash from the pinned tree before it is used. The
manual is published descriptor-relative: staging directory created with a
random name inside the validated state directory, files written O_EXCL
relative to it, the swap done with renameat against the retained parent
descriptor, the old tree removed by descriptor, the parent fsync'd. No
pathname is trusted after the parent has been opened.
"""
import hashlib
import json
import os
import re
import secrets
import shutil
import stat
import sys
import tarfile
import tempfile
import urllib.request
from html.parser import HTMLParser

DATA = os.path.abspath(os.path.expanduser(
    os.environ.get("OMARCHY_HELP_DATA", "~/.local/share/omarchy-help")))
# The official manual moved from basecamp/omarchy to the site repo
# (observed 2026-09-02); the branch is resolved, never assumed.
REPO = "omacom/omarchy-site"
API = "https://api.github.com/repos/" + REPO

_UID = os.getuid()
_HOME = os.path.abspath(os.path.expanduser("~"))


def _group_exclusive(gid):
    """A group-writable directory is acceptable only if the group is provably
    ours alone: our primary group, no other account has it as primary, and
    no member other than us."""
    import grp
    import pwd
    if gid != os.getgid():
        return False
    try:
        g = grp.getgrgid(gid)
        me = pwd.getpwuid(_UID).pw_name
    except KeyError:
        return False
    if any(m != me for m in g.gr_mem):
        return False
    return not any(p.pw_gid == gid and p.pw_uid != _UID for p in pwd.getpwall())


def _dir_ok(st):
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != _UID or (st.st_mode & 0o002):
        return False
    if st.st_mode & 0o020:
        return _group_exclusive(st.st_gid)
    return True


def _dirfd(path, create=False, mode=0o700):
    """Open a directory under $HOME by walking every component from the
    $HOME anchor with O_NOFOLLOW|O_DIRECTORY, validating each directory
    (ours, never world-writable, group-writable only if exclusive). A
    symlink anywhere on the path is refused. Returns the leaf descriptor;
    callers keep it for every relative operation that follows."""
    path = os.path.abspath(path)
    if path != _HOME and not path.startswith(_HOME + os.sep):
        raise PermissionError("outside $HOME: " + path)
    fd = os.open(_HOME, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        if not _dir_ok(os.fstat(fd)):
            raise PermissionError("untrusted $HOME")
        for comp in [c for c in path[len(_HOME):].split(os.sep) if c]:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            try:
                nfd = os.open(comp, flags, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(comp, mode, dir_fd=fd)
                nfd = os.open(comp, flags, dir_fd=fd)
            os.close(fd)
            fd = nfd
            if not _dir_ok(os.fstat(fd)):
                raise PermissionError("untrusted directory: " + path)
        return fd
    except BaseException:
        os.close(fd)
        raise


def get(url, cap=20_000_000):
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "archy-omarchy-manual-updater"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read(cap)


class ToMd(HTMLParser):
    SKIP = {"script", "style", "nav", "footer", "header", "head", "svg", "title"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.skip, self.pre = [], 0, False

    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP:
            self.skip += 1
        elif tag in ("h1", "h2", "h3", "h4"):
            self.out.append("\n\n" + "#" * int(tag[1]) + " ")
        elif tag == "li":
            self.out.append("\n- ")
        elif tag in ("p", "div", "section", "article", "tr", "br"):
            self.out.append("\n")
        elif tag == "pre":
            self.pre = True
            self.out.append("\n```\n")
        elif tag == "code" and not self.pre:
            self.out.append("`")

    def handle_endtag(self, tag):
        if tag in self.SKIP and self.skip:
            self.skip -= 1
        elif tag == "pre":
            self.pre = False
            self.out.append("\n```\n")
        elif tag == "code" and not self.pre:
            self.out.append("`")

    def handle_data(self, d):
        if self.skip:
            return
        if self.pre:
            self.out.append(d)
        else:
            t = " ".join(d.split())
            if t:
                self.out.append(t + " ")


def html_to_md(html):
    p = ToMd()
    p.feed(html)
    return re.sub(r"\n{3,}", "\n\n", "".join(p.out)).strip() + "\n"


def write_rel(dfd, name, data, mode=0o644):
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                 mode, dir_fd=dfd)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)


def main():
    # 1. Pin the commit of the resolved default branch; 2. list the manual
    # tree at that exact commit.
    branch = json.loads(get(API))["default_branch"]
    head = json.loads(get(API + "/commits/" + branch))
    commit = head["sha"]
    tree = json.loads(get(API + "/git/trees/" + head["commit"]["tree"]["sha"]))
    manual = next(e for e in tree["tree"] if e["path"] == "manual" and e["type"] == "tree")
    entries = json.loads(get(API + "/git/trees/" + manual["sha"] + "?recursive=1"))["tree"]
    pages = [e for e in entries if e["type"] == "blob" and e["path"].endswith("/index.html")
             and e["path"].count("/") == 1 and e.get("size", 0) < 2_000_000][:200]
    if not pages:
        raise SystemExit("no manual pages found at pinned commit — not updated")
    want = {"manual/" + e["path"]: e["sha"] for e in pages}

    # 3. Publish descriptor-relative inside the validated private state dir.
    dfd = _dirfd(DATA, create=True)
    try:
        staged = ".manual-" + secrets.token_hex(8)
        os.mkdir(staged, 0o700, dir_fd=dfd)
        sfd = os.open(staged, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
        try:
            # ONE download at the immutable commit, streamed to a temp inside staging.
            req = urllib.request.Request(
                "https://codeload.github.com/%s/tar.gz/%s" % (REPO, commit),
                headers={"User-Agent": "archy-omarchy-manual-updater"})
            tfd = os.open(".tarball", os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                          0o600, dir_fd=sfd)
            tb = os.fdopen(tfd, "w+b")
            with urllib.request.urlopen(req, timeout=120) as r:
                got = 0
                while True:
                    chunk = r.read(1 << 20)
                    if not chunk:
                        break
                    got += len(chunk)
                    if got > 300_000_000:
                        raise SystemExit("tarball unreasonably large — aborting")
                    tb.write(chunk)
            tb.flush()
            tb.seek(0)
            seen = 0
            with tarfile.open(fileobj=tb, mode="r:gz") as tf:
                for m in tf:
                    rel = m.name.split("/", 1)[1] if "/" in m.name else ""
                    if rel not in want or not m.isfile() or m.size > 2_000_000:
                        continue
                    data = tf.extractfile(m).read()
                    digest = hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()
                    if digest != want[rel]:
                        raise SystemExit("hash mismatch for %s — aborting, nothing replaced" % rel)
                    slug = rel.split("/")[1]
                    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,80}", slug):
                        continue
                    md = html_to_md(data.decode("utf-8", "replace"))
                    write_rel(sfd, slug + ".md", ("# " + slug.replace("-", " ") + "\n" + md).encode())
                    seen += 1
            tb.close()
            os.unlink(".tarball", dir_fd=sfd)
            if seen != len(want):
                raise SystemExit("tarball missing pages (%d/%d) — aborting" % (seen, len(want)))
            write_rel(sfd, ".fetched", (commit + "\n").encode())
            os.fsync(sfd)
        finally:
            os.close(sfd)

        # 4. Swap by descriptor: manual -> random old name, staged -> manual,
        #    remove old by descriptor, fsync the parent.
        old = None
        try:
            st = os.stat("manual", dir_fd=dfd, follow_symlinks=False)
            if not stat.S_ISDIR(st.st_mode):
                raise SystemExit("manual is not a directory — refusing to replace")
            old = ".manual-old-" + secrets.token_hex(8)
            os.rename("manual", old, src_dir_fd=dfd, dst_dir_fd=dfd)
        except FileNotFoundError:
            pass
        os.rename(staged, "manual", src_dir_fd=dfd, dst_dir_fd=dfd)
        os.fsync(dfd)
        if old:
            shutil.rmtree(old, ignore_errors=True, dir_fd=dfd)
            os.fsync(dfd)
        print("manual: %d pages verified at commit %s -> %s/manual" % (seen, commit[:12], DATA))
    except BaseException:
        try:
            shutil.rmtree(staged, ignore_errors=True, dir_fd=dfd)
        except Exception:
            pass
        raise
    finally:
        os.close(dfd)


if __name__ == "__main__":
    main()
