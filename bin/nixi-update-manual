#!/usr/bin/env python3
# omarchy:summary=Refresh Nixi's local copy of the nixarchy + Omarchy manuals
"""Fetch the manual into Nixi's private state dir so answers can cite the real
manual offline.

Two sources, because that is how the nixarchy manual is written: of Omarchy's
51 pages, 38 are word-for-word true on NixOS and 13 are rewritten. So the
nixarchy manual is fetched FIRST and wins every filename collision; the Omarchy
site then fills only the gaps it leaves. A page never gets overwritten (the
O_EXCL create is the guarantee) -- the second source simply skips what the
first already published.

Integrity: everything is fetched at ONE pinned commit — the default branch
head SHA is resolved first, the manual tree is listed at that exact commit,
ONE tarball is downloaded at that immutable SHA, and every page is verified
against its git blob hash from the pinned tree before it is used. The
manual is published descriptor-relative: staging directory created with a
random name inside the validated state directory, files written O_EXCL
relative to it, the swap done with renameat against the retained parent
descriptor, the old tree removed by descriptor, the parent fsync'd. No
pathname is trusted after the parent has been opened.
"""
import hashlib
import json
import os
import re
import secrets
import shutil
import stat
import tarfile
import urllib.request
from html.parser import HTMLParser

DATA = os.path.abspath(os.path.expanduser(
    os.environ.get("NIXI_DATA", "~/.local/share/nixi")))
UA = "nixi-manual-updater"
# Ordered: the first source to publish a slug owns it. nixarchy is
# authoritative on NixOS, so it comes first and Omarchy backfills the rest.
#   kind "md"   -> <subdir>/<slug>.md, already Markdown
#   kind "html" -> <subdir>/<slug>/index.html, converted here
SOURCES = (
    {"repo": "olafkfreund/nixarchy", "subdir": "docs/manual", "kind": "md"},
    {"repo": "omacom/omarchy-site", "subdir": "manual", "kind": "html"},
)

_UID = os.getuid()
_HOME = os.path.abspath(os.path.expanduser("~"))


def _group_exclusive(gid):
    """A group-writable directory is acceptable only if the group is provably
    ours alone: our primary group, no other account has it as primary, and
    no member other than us."""
    import grp
    import pwd
    if gid != os.getgid():
        return False
    try:
        g = grp.getgrgid(gid)
        me = pwd.getpwuid(_UID).pw_name
    except KeyError:
        return False
    if any(m != me for m in g.gr_mem):
        return False
    return not any(p.pw_gid == gid and p.pw_uid != _UID for p in pwd.getpwall())


def _dir_ok(st):
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != _UID or (st.st_mode & 0o002):
        return False
    if st.st_mode & 0o020:
        return _group_exclusive(st.st_gid)
    return True


def _dirfd(path, create=False, mode=0o700):
    """Open a directory under $HOME by walking every component from the
    $HOME anchor with O_NOFOLLOW|O_DIRECTORY, validating each directory
    (ours, never world-writable, group-writable only if exclusive). A
    symlink anywhere on the path is refused. Returns the leaf descriptor;
    callers keep it for every relative operation that follows."""
    path = os.path.abspath(path)
    if path != _HOME and not path.startswith(_HOME + os.sep):
        raise PermissionError("outside $HOME: " + path)
    fd = os.open(_HOME, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        if not _dir_ok(os.fstat(fd)):
            raise PermissionError("untrusted $HOME")
        for comp in [c for c in path[len(_HOME):].split(os.sep) if c]:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            try:
                nfd = os.open(comp, flags, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(comp, mode, dir_fd=fd)
                nfd = os.open(comp, flags, dir_fd=fd)
            os.close(fd)
            fd = nfd
            if not _dir_ok(os.fstat(fd)):
                raise PermissionError("untrusted directory: " + path)
        return fd
    except BaseException:
        os.close(fd)
        raise


def get(url, cap=20_000_000):
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": UA})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read(cap)


class ToMd(HTMLParser):
    SKIP = {"script", "style", "nav", "footer", "header", "head", "svg", "title"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.skip, self.pre = [], 0, False

    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP:
            self.skip += 1
        elif tag in ("h1", "h2", "h3", "h4"):
            self.out.append("\n\n" + "#" * int(tag[1]) + " ")
        elif tag == "li":
            self.out.append("\n- ")
        elif tag in ("p", "div", "section", "article", "tr", "br"):
            self.out.append("\n")
        elif tag == "pre":
            self.pre = True
            self.out.append("\n```\n")
        elif tag == "code" and not self.pre:
            self.out.append("`")

    def handle_endtag(self, tag):
        if tag in self.SKIP and self.skip:
            self.skip -= 1
        elif tag == "pre":
            self.pre = False
            self.out.append("\n```\n")
        elif tag == "code" and not self.pre:
            self.out.append("`")

    def handle_data(self, d):
        if self.skip:
            return
        if self.pre:
            self.out.append(d)
        else:
            t = " ".join(d.split())
            if t:
                self.out.append(t + " ")


def html_to_md(html):
    p = ToMd()
    p.feed(html)
    return re.sub(r"\n{3,}", "\n\n", "".join(p.out)).strip() + "\n"


def write_rel(dfd, name, data, mode=0o644):
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                 mode, dir_fd=dfd)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)


def _tree(api, sha, recursive=False):
    """One tree listing, refusing a truncated one. GitHub truncates large
    trees and says so; a silently short list would look like a manual that
    lost pages, so treat it as fatal rather than publishing a partial set."""
    t = json.loads(get(api + "/git/trees/" + sha + ("?recursive=1" if recursive else "")))
    if t.get("truncated"):
        raise SystemExit("tree listing truncated by the API — not updated")
    return t["tree"]


def _tree_at(api, path):
    """Resolve the default branch to an immutable commit, then list the blobs
    under `path` at exactly that commit.

    The subdirectory is walked one component at a time and only that subtree
    is listed recursively -- listing the whole repository instead would drag
    in every unrelated blob (and the response is capped, so a big repo would
    fail or truncate). Returns (commit, {repo_relative_path: blob_sha})."""
    branch = json.loads(get(api))["default_branch"]
    head = json.loads(get(api + "/commits/" + branch))
    commit = head["sha"]

    sha = head["commit"]["tree"]["sha"]
    for comp in path.split("/"):
        entry = next((e for e in _tree(api, sha)
                      if e["path"] == comp and e["type"] == "tree"), None)
        if entry is None:
            raise SystemExit("no %s directory at pinned commit %s" % (path, commit[:12]))
        sha = entry["sha"]

    want = {}
    for e in _tree(api, sha, recursive=True):
        if e["type"] == "blob" and e.get("size", 0) < 2_000_000:
            want[path + "/" + e["path"]] = e["sha"]
    return commit, want


def _slug_of(rel, subdir, kind):
    """The published page name, or None if this blob is not a manual page."""
    tail = rel[len(subdir) + 1:]
    if kind == "md":
        if not tail.endswith(".md") or "/" in tail:
            return None
        slug = tail[:-3]
    else:
        if not tail.endswith("/index.html") or tail.count("/") != 1:
            return None
        slug = tail.split("/")[0]
    return slug if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,80}", slug) else None


def fetch_source(sfd, src, taken):
    """Publish one source's pages into the staging dir, skipping any slug an
    earlier (higher-priority) source already owns. Returns (commit, written)."""
    api = "https://api.github.com/repos/" + src["repo"]
    commit, blobs = _tree_at(api, src["subdir"])
    want = {}
    for rel, sha in blobs.items():
        slug = _slug_of(rel, src["subdir"], src["kind"])
        if slug and slug not in taken:
            want[rel] = (sha, slug)
    if not want:
        raise SystemExit("no manual pages found in %s at pinned commit" % src["repo"])

    tmpname = ".tarball-" + secrets.token_hex(8)
    req = urllib.request.Request(
        "https://codeload.github.com/%s/tar.gz/%s" % (src["repo"], commit),
        headers={"User-Agent": UA})
    tfd = os.open(tmpname, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                  0o600, dir_fd=sfd)
    tb = os.fdopen(tfd, "w+b")
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            got = 0
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                got += len(chunk)
                if got > 300_000_000:
                    raise SystemExit("tarball unreasonably large — aborting")
                tb.write(chunk)
        tb.flush()
        tb.seek(0)
        seen = 0
        with tarfile.open(fileobj=tb, mode="r:gz") as tf:
            for m in tf:
                rel = m.name.split("/", 1)[1] if "/" in m.name else ""
                if rel not in want or not m.isfile() or m.size > 2_000_000:
                    continue
                sha, slug = want[rel]
                data = tf.extractfile(m).read()
                digest = hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()
                if digest != sha:
                    raise SystemExit("hash mismatch for %s — aborting, nothing replaced" % rel)
                text = data.decode("utf-8", "replace")
                body = text if src["kind"] == "md" else html_to_md(text)
                if src["kind"] == "md":
                    # strip the Jekyll front matter; keep a real H1 either way
                    body = re.sub(r"\A---\n.*?\n---\n", "", body, count=1, flags=re.S)
                head = "" if body.lstrip().startswith("# ") else \
                       "# " + slug.replace("-", " ") + "\n"
                write_rel(sfd, slug + ".md", (head + body).encode())
                taken.add(slug)
                seen += 1
    finally:
        tb.close()
        try:
            os.unlink(tmpname, dir_fd=sfd)
        except OSError:
            pass
    if seen != len(want):
        raise SystemExit("tarball missing pages (%d/%d) — aborting" % (seen, len(want)))
    return commit, seen


def main():
    dfd = _dirfd(DATA, create=True)
    staged = None
    try:
        staged = ".manual-" + secrets.token_hex(8)
        os.mkdir(staged, 0o700, dir_fd=dfd)
        sfd = os.open(staged, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                      dir_fd=dfd)
        try:
            taken, stamp, total = set(), [], 0
            for src in SOURCES:
                commit, n = fetch_source(sfd, src, taken)
                stamp.append("%s %s" % (src["repo"], commit))
                total += n
            write_rel(sfd, ".fetched", ("\n".join(stamp) + "\n").encode())
            os.fsync(sfd)
        finally:
            os.close(sfd)

        # Swap by descriptor: manual -> random old name, staged -> manual,
        # remove old by descriptor, fsync the parent.
        old = None
        try:
            st = os.stat("manual", dir_fd=dfd, follow_symlinks=False)
            if not stat.S_ISDIR(st.st_mode):
                raise SystemExit("manual is not a directory — refusing to replace")
            old = ".manual-old-" + secrets.token_hex(8)
            os.rename("manual", old, src_dir_fd=dfd, dst_dir_fd=dfd)
        except FileNotFoundError:
            pass
        os.rename(staged, "manual", src_dir_fd=dfd, dst_dir_fd=dfd)
        staged = None
        os.fsync(dfd)
        if old:
            shutil.rmtree(old, ignore_errors=True, dir_fd=dfd)
            os.fsync(dfd)
        print("manual: %d pages verified from %d sources -> %s/manual"
              % (total, len(SOURCES), DATA))
    except BaseException:
        if staged:
            try:
                shutil.rmtree(staged, ignore_errors=True, dir_fd=dfd)
            except Exception:
                pass
        raise
    finally:
        os.close(dfd)


if __name__ == "__main__":
    main()
