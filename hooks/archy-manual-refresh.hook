#!/usr/bin/env bash
# omarchy:summary=Refresh Archy's local copy of the Omarchy manual after each omarchy-update
# Runs from ~/.config/omarchy/hooks/post-update.d/ — a new Omarchy release
# means new docs, so Archy re-syncs in the same breath. Best-effort: an
# offline update day just means the weekly timer catches it later.
command -v omarchy-help-update-manual >/dev/null 2>&1 && omarchy-help-update-manual || true
