#!/usr/bin/env bash
# omarchy:summary=One-time first-boot welcome: offer Archy's guided setup tour
# Runs from ~/.config/omarchy/hooks/post-boot.d/. Fires once, ever: the offer
# only appears while Archy has no learning history at all.
[[ -e "$HOME/.local/share/omarchy-help/learning.json" ]] && exit 0
mkdir -p "$HOME/.local/share/omarchy-help"
printf '{}' > "$HOME/.local/share/omarchy-help/learning.json"
omarchy-notification-wait 2>/dev/null || true
omarchy-notification-send --glyph $'\U0001f44b' \
  "New to Omarchy? I can walk you through it" \
  "I'm Archy, your guide. Click for a 3-minute hands-on tour — AI setup, the keys, the moves." \
  --exec omarchy-help --tour
