[Unit]
Description=Nixi widget server (offline manual answers + agent relay)

[Service]
# NixOS keeps almost nothing in /usr/bin (env, and little else), so an
# Arch-shaped PATH makes the /usr/bin/env shebang fail with status 127.
Environment=PATH=%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Type=exec
# Voice input (optional). The Nix module passes the model as a store path; a
# plugin install has no Nix to do that, so point at the conventional spot and
# let the server say what is missing -- whisper-cli and ffmpeg just have to be
# on the PATH above. Fetch a model with:
#   mkdir -p ~/.local/share/nixi/models && \
#     whisper-cpp-download-ggml-model base.en ~/.local/share/nixi/models
Environment=NIXI_WHISPER_MODEL=%h/.local/share/nixi/models/ggml-base.en.bin
ExecStart=%h/.local/bin/nixi-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
