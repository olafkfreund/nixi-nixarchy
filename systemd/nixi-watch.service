[Unit]
Description=Nixi tip watcher (suggests workflow improvements, max one per day)
# The watcher talks to omarchy-notification-send, which needs a session. Started
# at default.target it ran before the shell existed, failed, and Restart=
# on-failure burned the start limit -- dead for the whole session (#56). Must
# match nix/hm-module.nix; tools/test_nixi.py asserts they do.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# NixOS keeps almost nothing in /usr/bin (env, and little else), so an
# Arch-shaped PATH makes the /usr/bin/env shebang fail with status 127.
Environment=PATH=%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Type=exec
ExecStart=%h/.local/bin/nixi-watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
